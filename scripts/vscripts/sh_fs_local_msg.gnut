		"#FS_ChalNotAccepting",
	]

	Assert( refs.len() <= FS_LOCALMSG_MAX_TOKEN )

	file.iTokenCount = refs.len()
	for ( int i = 0; i < refs.len(); i++ )
	{
		file.FS_LocalizedStrings[ i ] <- refs[ i ]
		#if SERVER
			file.FS_LocalizedStringMap[ refs[ i ] ] <- i
		#endif
	}

	#if DEVELOPER
		printt( "FS LocalMsg: registered " + string( file.iTokenCount ) + " tokens (disk loc)" )
	#endif
}

int function GetLocalizedStringsCount()
{
	return file.iTokenCount
}

string function Flowstate_FetchToken( int tokenID )
{
	// ID 0 is the "no token" sentinel the server sends for an empty ref; slot 0
	// holds #FS_NULL, which must never reach the display path.
	if ( tokenID == 0 )
		return ""

	if ( tokenID in file.FS_LocalizedStrings )
		return file.FS_LocalizedStrings[ tokenID ]
	return ""
}

#if SERVER
int function Flowstate_FetchTokenID( string ref )
{
	if ( ref == "" )
		return 0

	if ( ref in file.FS_LocalizedStringMap )
		return file.FS_LocalizedStringMap[ ref ]

	Warning( "LocalMsg: unregistered token '%s'", ref )
	return 0
}

bool function LocalizedTokenExists( string ref )
{
	return ( ref in file.FS_LocalizedStringMap )
}

void function FS_LocalMsg_StreamVar( entity player, int textType, string sendMessage )
{
	int msgLen = sendMessage.len()
	for ( int k = 0; k < msgLen; k++ )
	{
		int ch = expect int( sendMessage[ k ] )
		if ( ch < 0 )
			ch = 0
		if ( ch > FS_LOCALMSG_CHAR_MAX )
			ch = FS_LOCALMSG_CHAR_MAX
		Remote_CallFunction_NonReplay( player, "FS_ShowLocalMsg_AppendChar", textType, ch )
	}
}

void function LocalMsg( entity player, string ref, string subref = "", int uiType = eMsgUI.DEFAULT, float duration = 5.0, string varString = "", string varSubstring = "", string sound = "" )
{
	if ( !IsValid( player ) )
		return
	if ( !player.IsPlayer() || player.IsBot() )
		return

	int dataLen = varString.len() + varSubstring.len()
	if ( dataLen > FS_LOCALMSG_MAX_CHARS )
	{
		Warning( "LocalMsg: var data too long (%d)", dataLen )
		return
	}

	if ( dataLen > 0 )
	{
		FS_LocalMsg_StreamVar( player, 0, varString )
		FS_LocalMsg_StreamVar( player, 1, varSubstring )
	}

	int tokenID = Flowstate_FetchTokenID( ref )
	int subTokenID = 0
	if ( subref != "" )
		subTokenID = Flowstate_FetchTokenID( subref )

	Remote_CallFunction_NonReplay( player, "FS_DisplayLocalizedToken", tokenID, subTokenID, uiType, duration )

	if ( sound != "" )
		thread EmitSoundOnEntityOnlyToPlayer( player, player, sound )
}

// The VS bar's lock badge and device icons carry the whole answer now.
void function IBMM_Notify( entity player, string ibmmLockTypeToken, int enemyPlayerInputType, float duration = 5.0 )
{
}

// World-space notification panel (rest room / matching / challenge).
void function CreatePanelText_Localized( entity player, string ref, string subRef, string varString, string varSubstring, vector origin, vector angles, float textScale, int panelID = 0 )
{
	if ( !IsValid( player ) || !player.IsPlayer() || player.IsBot() || !player.p.isConnected )
		return

	int dataLen = varString.len() + varSubstring.len()
	if ( dataLen >= 599 )
	{
		Warning( "CreatePanelText_Localized: var data too long (%d)", dataLen )
		return
	}

	if ( dataLen > 0 )
	{
		for ( int textType = 0; textType < 2; textType++ )
		{
			string sendMessage = textType == 0 ? varString : varSubstring
			int msgLen = sendMessage.len()
			for ( int i = 0; i < msgLen; i++ )
			{
				int ch = expect int( sendMessage[ i ] )
				if ( ch < 0 )
					ch = 0
				if ( ch > FS_LOCALMSG_CHAR_MAX )
					ch = FS_LOCALMSG_CHAR_MAX
				Remote_CallFunction_NonReplay( player, "FS_PanelAppendChar", textType, ch )
			}
		}
	}

	int tokenID = 0
	int subTokenID = 0
	if ( ref != "" )
		tokenID = Flowstate_FetchTokenID( ref )
	if ( subRef != "" )
		subTokenID = Flowstate_FetchTokenID( subRef )

	Remote_CallFunction_NonReplay( player, "FS_CreateTextInfoPanelWithID_Localized", tokenID, subTokenID, origin, angles, textScale, panelID )
}

void function RemovePanelText( entity player, int id )
{
	if ( !IsValid( player ) || !player.IsPlayer() || player.IsBot() )
		return
	Remote_CallFunction_NonReplay( player, "Dev_DestroyTextInfoPanelWithID", id )
}

// Token-based score splash (LocalMsg + eMsgUI.EVENT / SPLASH).
void function LocalEventMsg( entity player, string ref, string varString = "", float duration = 5 )
{
	LocalMsg( player, ref, "", eMsgUI.EVENT, duration, varString )
}

void function LocalEventMsgDelayed( float eventdelay, entity player, string ref, string varString = "", float duration = 5 )
{
	thread
	(
		void function() : ( eventdelay, player, ref, varString, duration )
		{
			wait eventdelay
			if ( IsValid( player ) )
				LocalEventMsg( player, ref, varString, duration )
		}
	)()
}

// Freeform score splash -- any string, no token table required.
// Example: LocalSplashMsg( player, "Infinite Ammo Enabled" )
void function LocalSplashMsg( entity player, string text, float duration = FS_SPLASH_DEFAULT_DURATION, string sound = "" )
{
	if ( !IsValid( player ) || !player.IsPlayer() || player.IsBot() )
		return

	if ( text == "" || text == " " )
		return

	if ( text.len() > FS_LOCALMSG_MAX_CHARS )
	{
		Warning( "LocalSplashMsg: text too long (%d)", text.len() )
		return
	}

	FS_LocalMsg_StreamVar( player, 0, text )
	Remote_CallFunction_NonReplay( player, "FS_DisplaySplashMessage", duration )

	if ( sound != "" )
		thread EmitSoundOnEntityOnlyToPlayer( player, player, sound )
}

void function LocalSplashMsgAll( string text, float duration = FS_SPLASH_DEFAULT_DURATION, string sound = "" )
{
	foreach ( entity player in GetPlayerArray() )
		LocalSplashMsg( player, text, duration, sound )
}

void function LocalSplashMsgTeam( int team, string text, float duration = FS_SPLASH_DEFAULT_DURATION, string sound = "" )
{
	foreach ( entity player in GetPlayerArrayOfTeam( team ) )
		LocalSplashMsg( player, text, duration, sound )
}

void function LocalSplashMsgDelayed( float eventdelay, entity player, string text, float duration = FS_SPLASH_DEFAULT_DURATION, string sound = "" )
{
	thread
	(
		void function() : ( eventdelay, player, text, duration, sound )
		{
			wait eventdelay
			if ( IsValid( player ) )
				LocalSplashMsg( player, text, duration, sound )
		}
	)()
}
#endif // SERVER

#if CLIENT
void function FS_ShowLocalMsg_AppendChar( int textType, int charCode )
{
	string piece = format( "%c", charCode )
	if ( textType == 0 )
		file.fs_variableString += piece
	else
		file.fs_variableSubString += piece
}

void function FS_PanelAppendChar( int textType, int charCode )
{
	string piece = format( "%c", charCode )
	if ( textType == 0 )
		file.fs_panelVarString += piece
	else
		file.fs_panelVarSubString += piece
}

// World panel create: resolve tokens + streamed vars, feed Dev_CreateTextInfoPanelWithID.
void function FS_CreateTextInfoPanelWithID_Localized( int token, int subToken, vector origin, vector angles, float textScale, int panelID )
{
	string title = FS_ResolveDisplayString( token, file.fs_panelVarString )
	string body = FS_ResolveDisplayString( subToken, file.fs_panelVarSubString )

	file.fs_panelVarString = ""
	file.fs_panelVarSubString = ""

	// cl_utility.gnut globals consumed by Dev_CreateTextInfoPanelWithID
	dev_infoPanelTitleString = title
	dev_infoPanelTextString = body

	Dev_CreateTextInfoPanelWithID( origin, angles, false, textScale, panelID )
}

// Display text: Localize(token) from platform/localization only (no script fallback).
string function FS_ResolveDisplayString( int tokenID, string variablePart )
{
	string localToken = Flowstate_FetchToken( tokenID )
	if ( localToken == "" )
		return variablePart

	string base = Localize( localToken )
	// Missing disk entry: Localize may return the raw #KEY -- surface that so loc gaps are visible.
	if ( base == "" )
		base = localToken

	// Support one %s (or append when none).
	if ( variablePart != "" && base.find( "%s" ) != -1 )
		return format( base, variablePart )

	if ( variablePart != "" )
		return base + " " + variablePart

	return base
}

void function FS_DisplayLocalizedToken( int token, int subtoken, int uiType, float duration )
{
	string S = file.fs_variableString
	string SubS = file.fs_variableSubString

	// Optional: variable payload may itself be a #token.
	if ( S.len() > 1 && S.find( "#" ) == 0 )
		S = Localize( S )
	if ( SubS.len() > 1 && SubS.find( "#" ) == 0 )
		SubS = Localize( SubS )

	string Msg = FS_ResolveDisplayString( token, S )
	string SubMsg = FS_ResolveDisplayString( subtoken, SubS )

	file.fs_variableString = ""
	file.fs_variableSubString = ""

	if ( uiType == eMsgUI.EVENT || uiType == eMsgUI.SPLASH )
	{
		Flowstate_AddCustomScoreEventMessage( Msg, duration )
		return
	}

	FS_LocalMsg_DisplayAnnouncement( Msg, SubMsg, duration, uiType )
}

// Freeform path: consume streamed text and show score splash. A line of the
// form "#TOKEN" or "#TOKEN|arg" is localized here, so the server never has to
// know the player's language.
void function FS_DisplaySplashMessage( float duration )
{
	string text = file.fs_variableString
	file.fs_variableString = ""
	file.fs_variableSubString = ""

	Flowstate_AddCustomScoreEventMessage( FS_LocalizeSplashLines( text ), duration )
}

string function FS_LocalizeSplashLines( string text )
{
	if ( text.find( "#" ) == -1 )
		return text

	array<string> lines = split( text, "\n" )
	string result = ""
	foreach ( string line in lines )
	{
		if ( result != "" )
			result += "\n"
		result += FS_LocalizeSplashLine( line )
	}
	return result
}

string function FS_LocalizeSplashLine( string line )
{
	if ( line.len() < 2 || line.find( "#" ) != 0 )
		return line

	int sep = line.find( "|" )
	if ( sep == -1 )
		return Localize( line )

	string token = line.slice( 0, sep )
	string arg = line.slice( sep + 1 )
	return Localize( token, arg )
}

void function FS_LocalMsg_DisplayAnnouncement( string str1, string str2, float duration, int uiType )
{
	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return

	AnnouncementData announcement = Announcement_Create( str1 )
	Announcement_SetHideOnDeath( announcement, false )
	Announcement_SetDuration( announcement, duration )
	Announcement_SetPurge( announcement, true )

	int style = ANNOUNCEMENT_STYLE_GENERIC_WARNING
	switch ( uiType )
	{
		case eMsgUI.CIRCLE_WARNING:
			style = ANNOUNCEMENT_STYLE_CIRCLE_WARNING
			break
		case eMsgUI.BIG:
			style = ANNOUNCEMENT_STYLE_BIG
			break
		case eMsgUI.QUICK:
			style = ANNOUNCEMENT_STYLE_QUICK
			break
		case eMsgUI.SWEEP:
		case eMsgUI.WAVE:
			style = ANNOUNCEMENT_STYLE_SWEEP
			break
		case eMsgUI.RESULTS:
			style = ANNOUNCEMENT_STYLE_RESULTS
			break
		case eMsgUI.OBJECTIVE:
			style = ANNOUNCEMENT_STYLE_OBJECTIVE
			break
		case eMsgUI.ELITE:
			style = ANNOUNCEMENT_STYLE_ELITE
			break
		case eMsgUI.WARNING:
		case eMsgUI.DEFAULT:
		default:
			style = ANNOUNCEMENT_STYLE_GENERIC_WARNING
			break
	}

	if ( style == ANNOUNCEMENT_STYLE_GENERIC_WARNING )
	{
		Announcement_SetHeaderText( announcement, " " )
		if ( str2 == "" )
			Announcement_SetSubText( announcement, " " )
		else
			Announcement_SetSubText( announcement, str2 )
		Announcement_SetTitleColor( announcement, <1, 1, 1> )
		Announcement_SetVerticalOffset( announcement, 140 )
	}
	else
	{
		Announcement_SetSubText( announcement, str2 )
	}

	Announcement_SetStyle( announcement, style )
	AnnouncementFromClass( player, announcement )
}

// Score splash (Lockdown look). Queues; multiple messages stack.
void function Flowstate_AddCustomScoreEventMessage( string eventText, float duration )
{
	if ( eventText == " " || eventText == "" )
		return

	AddScoreStyleQueueMessage( eventText, duration )
}
#endif // CLIENT
