// Flowstate LocalMsg / LocalSplashMsg -- S21 bridge port.
// Server pushes token IDs or freeform text; client shows announcement or score splash RUI.
// Splash uses the Lockdown score-info queue (works in any gamemode).

global function INIT_Flowstate_Localization_Strings
global function Flowstate_FetchToken
global function GetLocalizedStringsCount

#if SERVER
	global function Flowstate_FetchTokenID
	global function LocalMsg
	global function LocalEventMsg
	global function LocalEventMsgDelayed
	global function LocalSplashMsg
	global function LocalSplashMsgAll
	global function LocalSplashMsgTeam
	global function LocalSplashMsgDelayed
	global function LocalizedTokenExists
	global function IBMM_Notify
	global function CreatePanelText_Localized
	global function RemovePanelText
#endif

#if CLIENT
	global function FS_ShowLocalMsg_AppendChar
	global function FS_DisplayLocalizedToken
	global function FS_DisplaySplashMessage
	global function Flowstate_AddCustomScoreEventMessage
	global function FS_PanelAppendChar
	global function FS_CreateTextInfoPanelWithID_Localized

	// Consumed by cl_utility Dev_CreateTextInfoPanelWithID (must load before cl_utility)
	global string dev_infoPanelTitleString = ""
	global string dev_infoPanelTextString = ""
#endif

global enum eMsgUI
{
	DEFAULT, 			// 0 -- generic_warning (FR rangemaster style)
	EVENT, 				// 1 -- score splash (lockdown style)
	CIRCLE_WARNING, 	// 2
	BIG, 				// 3
	QUICK, 				// 4
	SWEEP, 				// 5
	RESULTS, 			// 6
	OBJECTIVE, 			// 7
	ELITE, 				// 8
	WAVE, 				// 9
	SPLASH, 			// 10 -- same as EVENT (score splash queue)
	WARNING, 			// 11 -- same as DEFAULT
}

const int FS_LOCALMSG_MAX_TOKEN = 256
const int FS_LOCALMSG_MAX_CHARS = 2990
const int FS_LOCALMSG_CHAR_MAX = 255
const float FS_SPLASH_DEFAULT_DURATION = 4.0

struct
{
	// Token ID -> "#KEY" for LocalMsg remotes only. Display text lives in
	// platform/localization (localize_disk). No script English fallback.
	table<int, string> FS_LocalizedStrings = {}
	int iTokenCount = 0

	#if SERVER
		table<string, int> FS_LocalizedStringMap = {}
	#endif

	#if CLIENT
		string fs_variableString = ""
		string fs_variableSubString = ""
		string fs_panelVarString = ""
		string fs_panelVarSubString = ""
	#endif
} file

