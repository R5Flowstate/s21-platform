global function ShPassiveMantleBoost_Init

const int MANTLE_BOOST_STATE_UNBUFFERED = 0
const int MANTLE_BOOST_STATE_INVALID    = 1

struct
{
	var mantleBoostRui
	bool hintThreadStarted
} file

void function ShPassiveMantleBoost_Init()
{
	if ( !GetCurrentPlaylistVarBool( "mantle_boost_enabled", true ) )
		return

	AddCallback_CreatePlayerPassiveRui( PassiveMantleBoost_CreateHintRui )
	AddClientCallback_OnResolutionChanged( PassiveMantleBoost_OnResolutionChanged )
}

// The hint reads local-player state only, so it lives for the whole match and
// follows the local player itself rather than whichever entity triggered this.
void function PassiveMantleBoost_CreateHintRui( entity player )
{
	if ( file.hintThreadStarted )
		return

	file.hintThreadStarted = true
	thread PassiveMantleBoost_ShowHint_Thread()
}

void function PassiveMantleBoost_OnResolutionChanged()
{
	if ( file.mantleBoostRui != null && RuiIsAlive( file.mantleBoostRui ) )
		PassiveMantleBoost_SetResolution( file.mantleBoostRui )
}

void function PassiveMantleBoost_SetResolution( var rui )
{
	UISize screenSize = GetCurrentVirtualScreenSize( true )
	RuiSetResolution( rui, float( screenSize.width ), float( screenSize.height ) )
}

void function PassiveMantleBoost_EnsureRui()
{
	if ( file.mantleBoostRui != null && RuiIsAlive( file.mantleBoostRui ) )
		return

	// The asset name is only known once its pak is loaded, so it cannot be
	// written as a file-scope $"..." literal.
	asset hintAsset = GetKeyValueAsAsset( { kn = "ui/mantle_boost.rpak" }, "kn" )

	file.mantleBoostRui = CreateCockpitPostFXRui( hintAsset, 32000 )
	PassiveMantleBoost_SetResolution( file.mantleBoostRui )
}

void function PassiveMantleBoost_ShowHint_Thread()
{
	OnThreadEnd(
		function() : ()
		{
			RuiDestroyIfAlive( file.mantleBoostRui )
			file.mantleBoostRui = null
			file.hintThreadStarted = false
		}
	)

	float showRuiPersistTime = GetCurrentPlaylistVarFloat( "mantle_boost_rui_persist_time", 0.25 )

	entity trackedPlayer = null
	float traversalProgress = 0.0
	float lastMantleTime = 0.0
	int mantleBoostState = MANTLE_BOOST_STATE_UNBUFFERED

	while ( true )
	{
		PassiveMantleBoost_EnsureRui()

		bool showHint = false
		int inputSetting = GetConVarInt( "mantle_boost_input_setting" )
		int uiSetting = MantleBoost_GetUiSetting()

		entity player = GetLocalClientPlayer()
		bool isLocalView = IsValid( player ) && player == GetLocalViewPlayer() && IsAlive( player )

		if ( player != trackedPlayer )
		{
			trackedPlayer = player
			traversalProgress = 0.0
			lastMantleTime = 0.0
			mantleBoostState = MANTLE_BOOST_STATE_UNBUFFERED
		}

		if ( isLocalView )
		{
			bool isMantling = player.IsMantling()

			if ( isMantling )
			{
				lastMantleTime = Time()
				mantleBoostState = MantleBoost_GetState()
				RuiSetFloat( file.mantleBoostRui, "viewBasedOffset", MantleBoost_GetViewAngleRuiOffset() )
				RuiSetFloat( file.mantleBoostRui, "sweetSpotFrac", MantleBoost_GetSweetSpotFrac() )
			}
			else
			{
				traversalProgress = 0.0
				if ( MantleBoost_GetState() > MANTLE_BOOST_STATE_UNBUFFERED )
					mantleBoostState = MantleBoost_GetState()
			}

			// The indicator would otherwise sit under the muzzle flash of a shot
			// fired after the mantle started.
			bool shouldHideFromFiredWeapon = false
			entity weapon = player.GetActiveWeapon( eActiveInventorySlot.mainHand )
			if ( IsValid( weapon ) )
				shouldHideFromFiredWeapon = weapon.GetLastWeaponFireTime() > lastMantleTime

			showHint = inputSetting != 0
				&& mantleBoostState != MANTLE_BOOST_STATE_INVALID
				&& !shouldHideFromFiredWeapon
				&& ( isMantling || ( mantleBoostState != MANTLE_BOOST_STATE_UNBUFFERED
					&& ( Time() - lastMantleTime ) < showRuiPersistTime ) )

			if ( mantleBoostState == MANTLE_BOOST_STATE_UNBUFFERED && isMantling )
			{
				// Progress only ever moves forward within one climb. The sweet-spot
				// window is measured on the traversal animation, so the ring follows it.
				float curProgress = MantleBoost_GetTraversalAnimFrac()
				if ( curProgress > traversalProgress )
				{
					RuiSetFloat( file.mantleBoostRui, "progress", curProgress )
					traversalProgress = curProgress
				}

				RuiSetFloat( file.mantleBoostRui, "inputOffset", MantleBoost_GetCrosshairRuiOffset() )
			}
		}

		RuiSetInt( file.mantleBoostRui, "uiMode", uiSetting )
		RuiSetInt( file.mantleBoostRui, "state", mantleBoostState )
		RuiSetBool( file.mantleBoostRui, "isWallHang", showHint )
		RuiSetInt( file.mantleBoostRui, "inputSetting", inputSetting )

		WaitFrame()
	}
}
