const float CROSSHAIR_VERT_OFFSET = 32

vector function GetPlayerCrosshairOriginRaw( entity player )
{
	if ( player.HasThirdPersonAttackFocus() )
		return player.GetThirdPersonAttackFocus()

	vector angles = player.EyeAngles()
	vector forward = AnglesToForward( angles )
	vector origin = player.EyePosition()

	vector start = origin
	vector end = origin + forward * 50000
	TraceResults result = TraceLine( start, end )
	vector crosshairOrigin = result.endPos

	return crosshairOrigin
}

vector function GetPlayerCrosshairOrigin( entity player )
{
	return (GetPlayerCrosshairOriginRaw( player ) + <0,0,CROSSHAIR_VERT_OFFSET> )
}

void function SpawnBots( int amount = 1 )
{
	printt( format( "[SpawnBots] SpawnBots(%d)", amount ) )
	thread SpawnBotsInternal( amount, false )
}

void function SpawnAllyBots( int amount = 1 )
{
	thread SpawnBotsInternal( amount, true )
}

void function SpawnBotsInternal( int amount, bool asAlly )
{
	if ( amount < 1 )
		return

	int maxPlayers = GetCurrentPlaylistVarInt( "max_players", 60 )
	int used = GetNumHumanPlayers() + GetNumFakeClients()
	int remaining = maxPlayers - used
	if ( remaining < 1 )
	{
		printt( format( "[SpawnBots] server full humans=%d bots=%d max=%d", GetNumHumanPlayers(), GetNumFakeClients(), maxPlayers ) )
		return
	}
	if ( amount > remaining )
	{
		printt( format( "[SpawnBots] capping %d -> %d remaining (humans=%d bots=%d max=%d)", amount, remaining, GetNumHumanPlayers(), GetNumFakeClients(), maxPlayers ) )
		amount = remaining
	}

	int spawned = 0
	int serial = GetNumFakeClients()
	int lastTeam = TEAM_INVALID
	for ( int i = 0; i < amount; i++ )
	{
		int team = SpawnBots_ResolveTeam( asAlly )
		if ( team <= TEAM_SPECTATOR )
		{
			printt( format( "[SpawnBots] no playable team at %d/%d", spawned, amount ) )
			break
		}
		lastTeam = team

		string botName = "bot" + ( serial + i ).tostring()
		int edict = -1
		try
		{
			edict = CreateFakePlayer( botName, team )
		}
		catch ( spawnErr )
		{
			printt( format( "[SpawnBots] CreateFakePlayer threw at %d/%d team=%d: %s", spawned, amount, team, spawnErr ) )
			break
		}
		if ( edict < 0 )
		{
			printt( format( "[SpawnBots] CreateFakePlayer failed at %d/%d team=%d (humans=%d bots=%d max=%d)", spawned, amount, team, GetNumHumanPlayers(), GetNumFakeClients(), maxPlayers ) )
			break
		}
		spawned++
		WaitFrame()
	}

	printt( format( "[SpawnBots] spawned %d/%d lastTeam=%d ally=%s humans=%d bots=%d max=%d", spawned, amount, lastTeam, string( asAlly ), GetNumHumanPlayers(), GetNumFakeClients(), maxPlayers ) )
}

int function SpawnBots_TeamSize()
{
	int maxTeamSize = GetCurrentPlaylistVarInt( "max_team_size", 1 )
	if ( maxTeamSize < 1 )
		return 1
	return maxTeamSize
}

int function SpawnBots_FindEmptyTeam( int skipTeam )
{
	int maxTeams = GetCurrentPlaylistVarInt( "max_teams", MAX_TEAMS )
	int maxTeamSize = SpawnBots_TeamSize()
	if ( maxTeams < 1 )
		maxTeams = 1

	int first = TEAM_MULTITEAM_FIRST
	int last = first + maxTeams
	for ( int t = first; t < last; t++ )
	{
		if ( t == skipTeam )
			continue
		if ( GetPlayerArrayOfTeam( t ).len() < maxTeamSize )
			return t
	}

	if ( skipTeam > TEAM_SPECTATOR && GetPlayerArrayOfTeam( skipTeam ).len() < maxTeamSize )
		return skipTeam

	return TEAM_INVALID
}

int function SpawnBots_ResolveTeam( bool asAlly )
{
	entity host = SpawnBots_GetHostPlayer()
	int hostTeam = TEAM_IMC
	if ( IsValid( host ) )
	{
		int t = host.GetTeam()
		if ( t > TEAM_SPECTATOR )
			hostTeam = t
	}

	int maxTeamSize = SpawnBots_TeamSize()

	if ( asAlly )
	{
		if ( GetPlayerArrayOfTeam( hostTeam ).len() < maxTeamSize )
			return hostTeam
		return TEAM_INVALID
	}

	int playlistTeams = GetCurrentPlaylistVarInt( "max_teams", MAX_TEAMS )
	if ( playlistTeams <= 2 && maxTeamSize > 1 )
	{
		int enemy = TEAM_MILITIA
		if ( hostTeam == TEAM_MILITIA )
			enemy = TEAM_IMC
		if ( GetPlayerArrayOfTeam( enemy ).len() < maxTeamSize )
			return enemy
		return TEAM_INVALID
	}

	return SpawnBots_FindEmptyTeam( hostTeam )
}

entity function SpawnBots_GetHostPlayer()
{
	foreach ( entity p in GetPlayerArray() )
	{
		if ( IsValid( p ) && p.IsPlayer() && !p.IsBot() )
			return p
	}

	array<entity> players = GetPlayerArray()
	if ( players.len() > 0 && IsValid( players[0] ) )
		return players[0]
	return null
}

void function DisconnectAllBots()
{
	ServerCommand( "kick_all_bots" )
}

void function DEV_TeleportAllBotsToCrosshair( entity player )
{
	vector pos = GetPlayerCrosshairOrigin( player )
	foreach( bot in GetPlayerArray() )
	{
		if ( !bot.IsBot() )
			continue
		if ( bot.GetParent() != null )
			continue

		bot.SetOrigin( pos )
	}
}

void function DEV_TeleportAllPlayersTo( vector pos )
{
	foreach( thisPlayer in GetPlayerArray() )
		thisPlayer.SetOrigin( pos )
}

void function DEV_TeleportAllPlayersToCrosshair( entity player )
{
	vector pos = GetPlayerCrosshairOrigin( player )
	foreach( thisPlayer in GetPlayerArray() )
	{
		if ( player == thisPlayer )
			continue
		thisPlayer.SetOrigin( pos )
	}
}

void function DEV_SpawnWeaponAtCrosshair( string weaponName, array<string> mods = [] )
{
	printt( "script thread DEV_SpawnWeaponAtCrosshair( \"" + weaponName + "\")" )

	Assert( IsNewThread(), "Must be threaded off due to precache issues" )

	entity player = GetPlayerArray()[ 0 ]
	if ( !IsValid( player ) )
		return
	vector origin = GetPlayerCrosshairOrigin( player )
	vector angles = <0,0,0>
	entity weapon = CreateWeaponEntityByNameWithPhysics( weaponName, origin, angles )
	weapon.SetMods( mods )
}

// Scripted-activity strafe for NPCs. S3 has no SetBotMovementAndAngles / SetBotStrafeMovementByIndex.
const float FLOWSTATE_STRAFE_SPEED = 1.0
// Normal lateral commit windows (shorter = less ground covered per side)
const float FLOWSTATE_STRAFE_WAIT_MIN = 0.22
const float FLOWSTATE_STRAFE_WAIT_MAX = 0.5
// Hard laterals: short travel, same-side bias still avoids L/R restart thrash
const float FLOWSTATE_STRAFE_HARD_WAIT_MIN = 0.22
const float FLOWSTATE_STRAFE_HARD_WAIT_MAX = 0.42
const float FLOWSTATE_HARD_LONG_WAIT_MIN = 0.5
const float FLOWSTATE_HARD_LONG_WAIT_MAX = 0.75
// Unstuck: wall probe + low 2D progress aborts the current act and flips side
const float FLOWSTATE_WALL_PROBE_DIST = 56.0
const float FLOWSTATE_STUCK_DIST_SQR = 64.0 // ~8u in 0.1s slice = stalled against wall
const float FLOWSTATE_STUCK_SLICE = 0.1
const int FLOWSTATE_STUCK_SLICES_NEEDED = 2
// Anti-oscillation: rapid opposite-side flips with low net travel = stuck-in-place ADAD buzz
const int FLOWSTATE_HARD_FLIP_BREAKOUT = 3 // consecutive L<->R flips before forcing a real commit
const float FLOWSTATE_HARD_OSC_TRAVEL_SQR = 2500.0 // ~50u net 2D from window start = still "in place"
const float FLOWSTATE_HARD_COMMIT_MIN = 0.35
const float FLOWSTATE_HARD_COMMIT_MAX = 0.6
const int FLOWSTATE_HARD_UNSTUCK_DEPTH_AFTER = 2 // pure reverse twice -> try depth instead
// Ground plant: scripted root-motion has no gravity -- only rewrite Z under current XY
const float FLOWSTATE_GROUND_TRACE_UP = 40.0
const float NPC_IN_FLIGHT_SPEED = 50.0
const float FLOWSTATE_GROUND_TRACE_DOWN = 512.0 // find floor under modest ledges
const float FLOWSTATE_GROUND_STEP_UP = 48.0 // max rise per slice (ramps / stairs)
const float FLOWSTATE_GROUND_DROP_PER_SLICE = 56.0 // soft fall rate (~560 u/s), not a teleport
const float FLOWSTATE_GROUND_SNAP_EPS = 3.0 // ignore small Z noise (don't fight root-motion bob)
const int FLOWSTATE_GROUND_PLANT_EVERY_N = 3 // plant every N stuck-slices while grounded (not 10Hz)
// FR-style: only re-fire ScriptedPlay when activity string changes
const float FLOWSTATE_ANIM_BLEND = 0.3
const float FLOWSTATE_FACE_YAW_EPS = 8.0 // skip SetAngles under this delta (yaw thrash = hitch)
// Playback rate must re-apply after ScriptedPlay; range wide enough to read in-game
const float FLOWSTATE_RATE_MIN = 0.75
const float FLOWSTATE_RATE_MAX = 1.4

// Pattern strafe (right then left). Faces target yaw-only. smartHard mixes ADAD / hold / depth / crouch.
void function StartBotStrafeMovementPattern( entity bot, float forwardMove = 0.0, entity target = null, float waitMin = FLOWSTATE_STRAFE_WAIT_MIN, float waitMax = FLOWSTATE_STRAFE_WAIT_MAX, bool smartHard = false )
{
	if ( !IsValid( bot ) )
		return

	// If no target specified, try player 0
	if ( target == null )
	{
		array<entity> players = GetPlayerArray()
		if ( players.len() > 0 && IsValid( players[0] ) )
			target = players[0]
	}

	// Restart clean if already strafing
	bot.Signal( "StopBotStrafe" )
	if ( smartHard )
		thread BotHardStrafeMovementPatternThread( bot, target )
	else
		thread BotStrafeMovementPatternThread( bot, forwardMove, target, waitMin, waitMax )
	printt( "[FlowstateDummy] StartBotStrafeMovementPattern on " + string( bot ) + " hard=" + string( smartHard ) )
}

//-----------------------------------------------------------------------------
// Purpose: Stops bot/NPC strafing started by StartBotStrafeMovementPattern
//-----------------------------------------------------------------------------
void function StopBotStrafe( entity bot )
{
	if ( !IsValid( bot ) )
		return

	bot.Signal( "StopBotStrafe" )
	printt( "[FlowstateDummy] StopBotStrafe on " + string( bot ) )
}

// Lab strafer sliders. The mult lives on bot.ai so live strafe threads pick it
// up next iteration without a restart; the god flag gates the damage handlers.
float function FlowstateDummy_GetSpeedMult( entity bot )
{
	if ( !IsValid( bot ) || !bot.IsNPC() )
		return 1.0
	float mult = bot.ai.flowstateStrafeSpeedMult
	if ( mult <= 0.0 )
		return 1.0
	if ( mult < AIMTRAINER_STRAFE_SPEED_MIN )
		return AIMTRAINER_STRAFE_SPEED_MIN
	if ( mult > AIMTRAINER_STRAFE_SPEED_MAX )
		return AIMTRAINER_STRAFE_SPEED_MAX
	return mult
}

void function FlowstateDummy_SetSpeedMult( entity npc, float mult )
{
	if ( !IsValid( npc ) || !npc.IsNPC() )
		return
	if ( mult < AIMTRAINER_STRAFE_SPEED_MIN )
		mult = AIMTRAINER_STRAFE_SPEED_MIN
	if ( mult > AIMTRAINER_STRAFE_SPEED_MAX )
		mult = AIMTRAINER_STRAFE_SPEED_MAX
	npc.ai.flowstateStrafeSpeedMult = mult
}

// Infinite health for strafing bots: real damage path (client hit callbacks
// still fire), lethal hits land at 1 HP, idle refills to the spawn-time pool.
// AddEntityCallback asserts on a duplicate and that shuts the host down.
void function AimTrainerStrafer_SetGod( entity npc, bool on )
{
	if ( !IsValid( npc ) || !npc.IsNPC() || !IsAlive( npc ) )
		return

	npc.ai.flowstateInfiniteHealth = on
	if ( !on )
		return

	if ( npc.ai.flowstateGodMaxHealth < 1 )
	{
		npc.ai.flowstateGodMaxHealth = npc.GetMaxHealth()
		npc.ai.flowstateGodMaxShield = npc.GetShieldHealthMax()
		if ( npc.ai.flowstateGodMaxHealth < 1 )
			npc.ai.flowstateGodMaxHealth = npc.GetHealth()
		if ( npc.ai.flowstateGodMaxHealth < 1 )
			npc.ai.flowstateGodMaxHealth = 1
	}
	npc.e.lastDamagedTime = 0.0

	if ( !npc.e.entDamageCallbacks.contains( AimTrainerStrafer_OnDamaged ) )
		AddEntityCallback_OnDamaged( npc, AimTrainerStrafer_OnDamaged )
	if ( !npc.e.entPostDamageCallbacks.contains( AimTrainerStrafer_OnPostDamaged ) )
		AddEntityCallback_OnPostDamaged( npc, AimTrainerStrafer_OnPostDamaged )
	if ( !npc.ai.flowstateGodRegenActive )
		thread AimTrainerStrafer_RegenThink( npc )
}

void function AimTrainerStrafer_OnDamaged( entity npc, var damageInfo )
{
	if ( !IsValid( npc ) || !IsAlive( npc ) )
		return
	if ( !npc.ai.flowstateInfiniteHealth )
		return

	float damage = DamageInfo_GetDamage( damageInfo )
	if ( damage <= 0 )
		return

	int health = npc.GetHealth()
	int shield = npc.GetShieldHealth()
	float bodyDamage = max( 0.0, damage - float( shield ) )
	if ( bodyDamage < float( health ) )
		return

	int needed = int( bodyDamage ) + 1
	if ( needed < 1 )
		needed = 1
	if ( needed > 100000 )
		needed = 100000
	if ( health < needed )
		npc.SetHealth( needed )
}

void function AimTrainerStrafer_OnPostDamaged( entity npc, var damageInfo )
{
	if ( !IsValid( npc ) || !IsAlive( npc ) )
		return
	if ( !npc.ai.flowstateInfiniteHealth )
		return

	npc.e.lastDamagedTime = Time()

	if ( npc.GetHealth() < 1 )
		npc.SetHealth( 1 )
}

void function AimTrainerStrafer_RegenThink( entity npc )
{
	EndSignal( npc, "OnDestroy" )
	EndSignal( npc, "OnDeath" )

	npc.ai.flowstateGodRegenActive = true
	OnThreadEnd(
		function() : ( npc )
		{
			if ( IsValid( npc ) && npc.IsNPC() )
				npc.ai.flowstateGodRegenActive = false
		}
	)

	while ( IsValid( npc ) && IsAlive( npc ) )
	{
		if ( !npc.ai.flowstateInfiniteHealth )
			return

		if ( ( Time() - npc.e.lastDamagedTime ) < AIMTRAINER_STRAFER_GOD_REGEN_IDLE )
		{
			wait 0.1
			continue
		}

		int wantHealth = npc.ai.flowstateGodMaxHealth
		int wantShield = npc.ai.flowstateGodMaxShield
		if ( npc.GetHealth() >= wantHealth && npc.GetShieldHealth() >= wantShield )
		{
			wait 0.1
			continue
		}

		float startTime = Time()
		float startLastDamage = npc.e.lastDamagedTime
		int startHealth = npc.GetHealth()
		int startShield = npc.GetShieldHealth()

		while ( IsValid( npc ) && IsAlive( npc ) && ( Time() - startTime ) < AIMTRAINER_STRAFER_GOD_REGEN_DURATION )
		{
			if ( !npc.ai.flowstateInfiniteHealth )
				return
			if ( npc.e.lastDamagedTime != startLastDamage )
				break

			float t = ( Time() - startTime ) / AIMTRAINER_STRAFER_GOD_REGEN_DURATION
			npc.SetHealth( int( GraphCapped( t, 0.0, 1.0, float( startHealth ), float( wantHealth ) ) ) )
			npc.SetShieldHealth( int( GraphCapped( t, 0.0, 1.0, float( startShield ), float( wantShield ) ) ) )
			wait 0.05
		}

		wait 0.1
	}
}

// Copies the owner's Lab slider prefs onto a fresh strafer.
void function FlowstateDummy_ApplyOwnerPrefs( entity player, entity npc )
{
	if ( !IsValid( npc ) )
		return

	float mult = AIMTRAINER_STRAFE_SPEED_DEFAULT
	bool god = false
	if ( IsValid( player ) && player.IsPlayer() )
	{
		mult = player.p.aimTrainerStrafeSpeedMult
		god = player.p.aimTrainerStraferInfiniteHealth
	}
	FlowstateDummy_SetSpeedMult( npc, mult )
	if ( god )
	{
		try
		{
			AimTrainerStrafer_SetGod( npc, true )
		}
		catch ( eGod )
		{
			printt( format( "[AimTrainer] ApplyOwnerPrefs SetGod failed: %s", string( eGod ) ) )
		}
	}
}

// Yaw-only face -- keeps pitch/roll at 0 so the dummy stays upright on the ground.
// Skips tiny yaw snaps (SetAngles every brain tick hitch root-motion).
void function FlowstateDummy_FaceTargetYawOnly( entity bot, entity target )
{
	if ( !IsValid( bot ) || !IsValid( target ) )
		return

	vector delta = target.GetOrigin() - bot.GetOrigin()
	delta.z = 0
	float wantYaw = VectorToAngles( delta ).y
	float curYaw = bot.GetAngles().y
	float dYaw = fabs( AngleDiff( wantYaw, curYaw ) )
	if ( dYaw < FLOWSTATE_FACE_YAW_EPS )
		return

	bot.SetAngles( <0.0, wantYaw, 0.0> )
}

// ---- Ground plant (Z only) --------------------------------------------------
// Scripted activities drive lateral root-motion with no gravity. Conform feet to
// the floor under the CURRENT XY each slice -- never rewrite X/Y so anim locomotion
// stays authoritative. Soft-drops tall ledges instead of teleporting.
// true = ground found in range (planted or mid-drop toward it)
// Airborne with real velocity = launched (jump pad, knockback) or falling under gravity.
// Only a dummy hanging in the air with no velocity needs a ground plant.
bool function NPC_IsInFlight( entity npc )
{
	if ( IsValid( npc.GetGroundEntity() ) )
		return false
	return LengthSqr( npc.GetVelocity() ) > NPC_IN_FLIGHT_SPEED * NPC_IN_FLIGHT_SPEED
}

bool function FlowstateDummy_ConformToGround( entity bot )
{
	if ( !IsValid( bot ) )
		return false
	if ( NPC_IsInFlight( bot ) )
		return false

	vector pos = bot.GetOrigin()
	TraceResults tr = GetGroundPosition( pos + <0, 0, FLOWSTATE_GROUND_TRACE_UP>, pos + <0, 0, -FLOWSTATE_GROUND_TRACE_DOWN>, [ bot ] )
	if ( tr.fraction >= 1.0 )
		return false

	float groundZ = tr.endPos.z
	float dz = groundZ - pos.z

	// Surface well above us -- blocked step / hit a low ceiling; leave XY alone
	if ( dz > FLOWSTATE_GROUND_STEP_UP )
		return IsValid( bot.GetGroundEntity() )

	if ( fabs( dz ) <= FLOWSTATE_GROUND_SNAP_EPS )
		return true

	// Soft fall: approach ground over slices so tall drops don't pop
	if ( dz < -FLOWSTATE_GROUND_DROP_PER_SLICE )
		groundZ = pos.z - FLOWSTATE_GROUND_DROP_PER_SLICE

	if ( !TrySetOriginInWorld( bot, <pos.x, pos.y, groundZ> ) )
		return false
	return true
}

// Unstuck: probe the move dir for a wall; abort and reverse if 2D progress stalls.

bool function FlowstateDummy_IsDirBlocked( entity bot, vector dir, float dist = FLOWSTATE_WALL_PROBE_DIST )
{
	if ( !IsValid( bot ) )
		return true

	vector start = bot.GetOrigin() + <0, 0, 40>
	vector end = start + ( dir * dist )
	TraceResults tr = TraceLine( start, end, bot, TRACE_MASK_SOLID, TRACE_COLLISION_GROUP_NONE )
	return ( tr.fraction < 0.92 )
}

bool function FlowstateDummy_IsSideBlocked( entity bot, int side )
{
	// side 0 = left, 1 = right (relative to current yaw)
	vector right = AnglesToRight( bot.GetAngles() )
	vector dir = ( side == 0 ) ? ( right * -1.0 ) : right
	return FlowstateDummy_IsDirBlocked( bot, dir )
}

int function FlowstateDummy_PickOpenSide( entity bot, int preferredSide )
{
	bool leftBlocked = FlowstateDummy_IsSideBlocked( bot, 0 )
	bool rightBlocked = FlowstateDummy_IsSideBlocked( bot, 1 )

	if ( preferredSide == 0 && leftBlocked && !rightBlocked )
		return 1
	if ( preferredSide == 1 && rightBlocked && !leftBlocked )
		return 0
	if ( leftBlocked && !rightBlocked )
		return 1
	if ( rightBlocked && !leftBlocked )
		return 0
	return preferredSide
}

string function FlowstateHard_SideAct( int side, bool crouch )
{
	// side 0 = left, 1 = right. ACT_RUN_* = crouch strafe, ACT_SPRINT_* = standing.
	if ( crouch )
		return ( side == 0 ) ? "ACT_RUN_LEFT" : "ACT_RUN_RIGHT"
	return ( side == 0 ) ? "ACT_SPRINT_LEFT" : "ACT_SPRINT_RIGHT"
}

// Only re-fire ScriptedPlay when activity changes. Always re-apply playback rate after
// (SetPlaybackRate is ignored/stale if we skip it when the act is already running).
// State: ServerAIStruct.flowstateLastAct / flowstateLastPlaybackRate
void function FlowstateDummy_PlayActivityIfChanged( entity bot, string activity, float playbackRate = FLOWSTATE_STRAFE_SPEED, float blend = FLOWSTATE_ANIM_BLEND )
{
	if ( !IsValid( bot ) )
		return

	if ( playbackRate < 0.1 )
		playbackRate = 0.1
	if ( playbackRate > AIMTRAINER_STRAFE_SPEED_MAX )
		playbackRate = AIMTRAINER_STRAFE_SPEED_MAX

	if ( bot.ai.flowstateLastAct != activity )
	{
		bot.Anim_ScriptedPlayActivityByName( activity, true, blend )
		bot.ai.flowstateLastAct = activity
	}

	// Always apply -- rate is how tempo spikes actually land mid same-side run
	bot.Anim_SetPlaybackRate( playbackRate )
	bot.ai.flowstateLastPlaybackRate = playbackRate
}

// true = finished duration, false = aborted early (stuck / invalid)
bool function FlowstateDummy_PlayStrafeAct( entity bot, string activity, float duration, float playbackRate = FLOWSTATE_STRAFE_SPEED, bool checkStuck = true )
{
	if ( !IsValid( bot ) )
		return false

	FlowstateDummy_PlayActivityIfChanged( bot, activity, playbackRate )
	// Plant once up-front so the first frame is not mid-air after a prior act
	FlowstateDummy_ConformToGround( bot )

	bool isHold = ( !checkStuck || activity == "ACT_STAND" || activity == "ACT_CROUCHIDLE" )
	float endTime = Time() + duration
	vector lastPos = bot.GetOrigin()
	int stuckSlices = 0
	int sliceCount = 0

	while ( IsValid( bot ) && Time() < endTime )
	{
		float remaining = endTime - Time()
		float slice = FLOWSTATE_STUCK_SLICE
		if ( remaining < slice )
			slice = remaining
		if ( slice <= 0.0 )
			break

		wait slice
		if ( !IsValid( bot ) )
			return false

		sliceCount++
		// Z plant: always if airborne; otherwise every N slices (avoid 10Hz SetOrigin fight)
		bool airborne = !IsValid( bot.GetGroundEntity() )
		if ( airborne || ( sliceCount % FLOWSTATE_GROUND_PLANT_EVERY_N ) == 0 )
		{
			FlowstateDummy_ConformToGround( bot )
			if ( !IsValid( bot ) )
				return false
		}

		if ( isHold )
			continue

		float movedSqr = Distance2DSqr( bot.GetOrigin(), lastPos )
		if ( movedSqr < FLOWSTATE_STUCK_DIST_SQR )
		{
			stuckSlices++
			if ( stuckSlices >= FLOWSTATE_STUCK_SLICES_NEEDED )
				return false
		}
		else
		{
			stuckSlices = 0
		}
		lastPos = bot.GetOrigin()
	}

	return IsValid( bot )
}

// On stuck: short burst opposite the failed side (and prefer open wall probe).
int function FlowstateDummy_UnstuckReverse( entity bot, int failedSide, entity target )
{
	if ( !IsValid( bot ) )
		return failedSide

	int other = ( failedSide == 0 ) ? 1 : 0
	other = FlowstateDummy_PickOpenSide( bot, other )

	if ( IsValid( target ) )
		FlowstateDummy_FaceTargetYawOnly( bot, target )

	// Slightly longer than old 0.18-0.4 so reverse actually clears the wall footprint
	FlowstateDummy_PlayStrafeAct( bot, FlowstateHard_SideAct( other, false ), RandomFloatRange( 0.28, 0.5 ), FLOWSTATE_STRAFE_SPEED * FlowstateDummy_GetSpeedMult( bot ), true )
	return other
}

// Depth step when pure L/R reverse is looping (wall corner / place-buzz).
// Returns true if a depth act ran (caller should reset flip/unstuck counters).
bool function FlowstateHard_TryDepthStep( entity bot, float rate = FLOWSTATE_STRAFE_SPEED )
{
	if ( !IsValid( bot ) )
		return false

	vector fwd = AnglesToForward( bot.GetAngles() )
	bool fwdBlocked = FlowstateDummy_IsDirBlocked( bot, fwd )
	bool backBlocked = FlowstateDummy_IsDirBlocked( bot, fwd * -1.0 )
	string depthAct = ""
	if ( fwdBlocked && !backBlocked )
		depthAct = "ACT_SPRINT_BACKWARD"
	else if ( !fwdBlocked && backBlocked )
		depthAct = "ACT_SPRINT_FORWARD"
	else if ( !fwdBlocked && !backBlocked )
		depthAct = CoinFlip() ? "ACT_SPRINT_FORWARD" : "ACT_SPRINT_BACKWARD"
	else
		return false

	FlowstateDummy_PlayStrafeAct( bot, depthAct, RandomFloatRange( 0.22, 0.45 ), rate, true )
	return true
}

// Long same-side commit to break short-range ADAD oscillation.
int function FlowstateHard_CommitSide( entity bot, int preferredSide, entity target, bool crouch = false )
{
	if ( !IsValid( bot ) )
		return preferredSide

	int side = FlowstateDummy_PickOpenSide( bot, preferredSide )
	if ( IsValid( target ) )
		FlowstateDummy_FaceTargetYawOnly( bot, target )

	float dur = RandomFloatRange( FLOWSTATE_HARD_COMMIT_MIN, FLOWSTATE_HARD_COMMIT_MAX )
	bool ok = FlowstateDummy_PlayStrafeAct( bot, FlowstateHard_SideAct( side, crouch ), dur, FlowstateHard_PickPlaybackRate( bot ), true )
	if ( !ok && IsValid( bot ) )
		return FlowstateDummy_UnstuckReverse( bot, side, target )
	return side
}

float function FlowstateHard_PickStrafeDuration()
{
	// Mostly short laterals; occasional longer hold so aim re-settles
	if ( RandomInt( 100 ) < 18 )
		return RandomFloatRange( FLOWSTATE_HARD_LONG_WAIT_MIN, FLOWSTATE_HARD_LONG_WAIT_MAX )
	return RandomFloatRange( FLOWSTATE_STRAFE_HARD_WAIT_MIN, FLOWSTATE_STRAFE_HARD_WAIT_MAX )
}

float function FlowstateHard_PickPlaybackRate( entity bot )
{
	float mult = FlowstateDummy_GetSpeedMult( bot )
	// Weighted so tempo is readable: slow / normal / fast
	int roll = RandomInt( 100 )
	if ( roll < 20 )
		return RandomFloatRange( FLOWSTATE_RATE_MIN, 0.9 ) * mult // slow track
	if ( roll < 55 )
		return RandomFloatRange( 0.95, 1.1 ) * mult // normal
	if ( roll < 85 )
		return RandomFloatRange( 1.15, 1.3 ) * mult // fast
	return RandomFloatRange( 1.3, FLOWSTATE_RATE_MAX ) * mult // spike
}

// true when consecutive opposite flips + low net travel = place-buzz ADAD
bool function FlowstateHard_IsOscillating( entity bot, vector windowOrigin, int flipStreak )
{
	if ( !IsValid( bot ) )
		return false
	if ( flipStreak < FLOWSTATE_HARD_FLIP_BREAKOUT )
		return false
	return Distance2DSqr( bot.GetOrigin(), windowOrigin ) < FLOWSTATE_HARD_OSC_TRAVEL_SQR
}

//-----------------------------------------------------------------------------
// Purpose: Thread -- continuous right/left strafe pattern (Flowstate StrafeMovement)
//-----------------------------------------------------------------------------
void function BotStrafeMovementPatternThread( entity bot, float forwardMove, entity target, float waitMin, float waitMax )
{
	bot.EndSignal( "OnDestroy" )
	bot.EndSignal( "OnDeath" )
	bot.EndSignal( "StopBotStrafe" )

	if ( target != null )
		target.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function() : ( bot )
		{
			if ( IsValid( bot ) )
				printt( "[FlowstateDummy] BotStrafeMovementPatternThread end for " + string( bot ) )
		}
	)

	bool hasTarget = ( target != null && IsValid( target ) )
	const string NO_GROUNDENTITY_ANIM = "ACT_FALL"
	int side = 1 // start right (legacy order)

	while ( IsValid( bot ) )
	{
		if ( hasTarget && IsValid( target ) )
			FlowstateDummy_FaceTargetYawOnly( bot, target )

		// No ground entity: soft-fall plant (Z only). ACT_FALL is cosmetic while dropping.
		if ( !IsValid( bot.GetGroundEntity() ) )
		{
			if ( FlowstateDummy_ConformToGround( bot ) && IsValid( bot.GetGroundEntity() ) )
				continue
			FlowstateDummy_PlayActivityIfChanged( bot, NO_GROUNDENTITY_ANIM, FLOWSTATE_STRAFE_SPEED * FlowstateDummy_GetSpeedMult( bot ) )
			wait FLOWSTATE_STUCK_SLICE
			FlowstateDummy_ConformToGround( bot )
			continue
		}

		side = FlowstateDummy_PickOpenSide( bot, side )
		bool ok = FlowstateDummy_PlayStrafeAct( bot, FlowstateHard_SideAct( side, false ), RandomFloatRange( waitMin, waitMax ), FLOWSTATE_STRAFE_SPEED * FlowstateDummy_GetSpeedMult( bot ), true )
		if ( !IsValid( bot ) )
			break

		if ( !ok )
			side = FlowstateDummy_UnstuckReverse( bot, side, target )
		else
			side = ( side == 0 ) ? 1 : 0
	}
}

// Human-like hard strafe brain: mix sides, stutters, holds, depth steps, crouch, tempo spikes + unstuck.
// Anti-oscillation: consecutive short L<->R with low net travel forces depth/long-commit breakout.
void function BotHardStrafeMovementPatternThread( entity bot, entity target )
{
	bot.EndSignal( "OnDestroy" )
	bot.EndSignal( "OnDeath" )
	bot.EndSignal( "StopBotStrafe" )

	if ( target != null )
		target.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function() : ( bot )
		{
			if ( IsValid( bot ) )
				printt( "[FlowstateDummy] BotHardStrafeMovementPatternThread end for " + string( bot ) )
		}
	)

	bool hasTarget = ( target != null && IsValid( target ) )
	const string NO_GROUNDENTITY_ANIM = "ACT_FALL"
	int lastSide = RandomInt( 2 ) // 0 left, 1 right
	int flipStreak = 0
	int unstuckStreak = 0
	vector oscWindowOrigin = bot.GetOrigin()

	while ( IsValid( bot ) )
	{
		if ( hasTarget && IsValid( target ) )
			FlowstateDummy_FaceTargetYawOnly( bot, target )

		// No ground entity: soft-fall plant (Z only). ACT_FALL is cosmetic while dropping.
		if ( !IsValid( bot.GetGroundEntity() ) )
		{
			if ( FlowstateDummy_ConformToGround( bot ) && IsValid( bot.GetGroundEntity() ) )
				continue
			FlowstateDummy_PlayActivityIfChanged( bot, NO_GROUNDENTITY_ANIM, FLOWSTATE_STRAFE_SPEED * FlowstateDummy_GetSpeedMult( bot ) )
			wait FLOWSTATE_STUCK_SLICE
			FlowstateDummy_ConformToGround( bot )
			continue
		}

		// Place-buzz breakout: too many opposite flips with almost no net travel
		if ( FlowstateHard_IsOscillating( bot, oscWindowOrigin, flipStreak ) )
		{
			printt( "[FlowstateDummy] hard breakout osc flips=" + string( flipStreak ) )
			float rate = FlowstateHard_PickPlaybackRate( bot )
			if ( FlowstateHard_TryDepthStep( bot, rate ) )
			{
				// depth cleared the lateral loop
			}
			else
			{
				// both depth axes blocked -- hold then long commit same open side
				FlowstateDummy_PlayStrafeAct( bot, "ACT_STAND", RandomFloatRange( 0.12, 0.28 ), rate, false )
				if ( IsValid( bot ) )
					lastSide = FlowstateHard_CommitSide( bot, lastSide, target, false )
			}
			flipStreak = 0
			unstuckStreak = 0
			if ( IsValid( bot ) )
				oscWindowOrigin = bot.GetOrigin()
			continue
		}

		int roll = RandomInt( 100 )
		// Near place-buzz: skip ADAD stutter (depth / holds / commits stay legal)
		if ( flipStreak >= ( FLOWSTATE_HARD_FLIP_BREAKOUT - 1 ) && roll >= 22 && roll < 26 )
			roll = 70
		float rate = FlowstateHard_PickPlaybackRate( bot )
		bool ok = true
		int sideBefore = lastSide

		if ( roll < 12 )
		{
			// Micro-hold / peek (human pause between ADAD) -- also resets flip window
			FlowstateDummy_PlayStrafeAct( bot, "ACT_STAND", RandomFloatRange( 0.08, 0.26 ), rate, false )
			flipStreak = 0
			unstuckStreak = 0
			if ( IsValid( bot ) )
				oscWindowOrigin = bot.GetOrigin()
		}
		else if ( roll < 22 )
		{
			// Depth step -- pick open axis dir first
			if ( FlowstateHard_TryDepthStep( bot, rate ) )
			{
				flipStreak = 0
				unstuckStreak = 0
				if ( IsValid( bot ) )
					oscWindowOrigin = bot.GetOrigin()
			}
			else
			{
				// both axes blocked -- reverse once, or depth-or-commit if reverse is looping
				unstuckStreak++
				if ( unstuckStreak >= FLOWSTATE_HARD_UNSTUCK_DEPTH_AFTER )
				{
					lastSide = FlowstateHard_CommitSide( bot, lastSide, target, false )
					unstuckStreak = 0
					flipStreak = 0
					if ( IsValid( bot ) )
						oscWindowOrigin = bot.GetOrigin()
				}
				else
				{
					lastSide = FlowstateDummy_UnstuckReverse( bot, lastSide, target )
					if ( lastSide != sideBefore )
						flipStreak++
					else
						flipStreak = 0
				}
			}
		}
		else if ( roll < 26 )
		{
			// Rare ADAD: only longer flicks (short L/R restarts look like low FPS)
			int side = FlowstateDummy_PickOpenSide( bot, lastSide )
			int other = FlowstateDummy_PickOpenSide( bot, ( side == 0 ) ? 1 : 0 )
			bool crouch = ( RandomInt( 100 ) < 20 )
			ok = FlowstateDummy_PlayStrafeAct( bot, FlowstateHard_SideAct( side, crouch ), RandomFloatRange( 0.28, 0.45 ), rate, true )
			if ( !ok && IsValid( bot ) )
			{
				unstuckStreak++
				if ( unstuckStreak >= FLOWSTATE_HARD_UNSTUCK_DEPTH_AFTER && FlowstateHard_TryDepthStep( bot, rate ) )
				{
					unstuckStreak = 0
					flipStreak = 0
					if ( IsValid( bot ) )
						oscWindowOrigin = bot.GetOrigin()
				}
				else
				{
					lastSide = FlowstateDummy_UnstuckReverse( bot, side, target )
					flipStreak++
				}
				continue
			}
			if ( !IsValid( bot ) )
				break
			ok = FlowstateDummy_PlayStrafeAct( bot, FlowstateHard_SideAct( other, crouch ), RandomFloatRange( 0.22, 0.38 ), rate, true )
			if ( !ok && IsValid( bot ) )
			{
				lastSide = FlowstateDummy_UnstuckReverse( bot, other, target )
				flipStreak += 2
				continue
			}
			if ( !IsValid( bot ) )
				break
			ok = FlowstateDummy_PlayStrafeAct( bot, FlowstateHard_SideAct( side, crouch ), FlowstateHard_PickStrafeDuration(), rate, true )
			if ( !ok && IsValid( bot ) )
			{
				lastSide = FlowstateDummy_UnstuckReverse( bot, side, target )
				flipStreak++
			}
			else
			{
				lastSide = side
				// L-R-L counts as two flips
				flipStreak += 2
				unstuckStreak = 0
			}
		}
		else if ( roll < 48 )
		{
			// Double same side -- human holds a direction instead of perfect alternate
			int side = ( RandomInt( 100 ) < 65 ) ? lastSide : RandomInt( 2 )
			side = FlowstateDummy_PickOpenSide( bot, side )
			bool crouch = ( RandomInt( 100 ) < 30 )
			ok = FlowstateDummy_PlayStrafeAct( bot, FlowstateHard_SideAct( side, crouch ), FlowstateHard_PickStrafeDuration(), rate, true )
			if ( !ok && IsValid( bot ) )
			{
				unstuckStreak++
				if ( unstuckStreak >= FLOWSTATE_HARD_UNSTUCK_DEPTH_AFTER && FlowstateHard_TryDepthStep( bot, rate ) )
				{
					unstuckStreak = 0
					flipStreak = 0
					if ( IsValid( bot ) )
						oscWindowOrigin = bot.GetOrigin()
				}
				else
				{
					lastSide = FlowstateDummy_UnstuckReverse( bot, side, target )
					if ( lastSide != side )
						flipStreak++
				}
				continue
			}
			if ( !IsValid( bot ) )
				break
			if ( hasTarget && IsValid( target ) )
				FlowstateDummy_FaceTargetYawOnly( bot, target )
			side = FlowstateDummy_PickOpenSide( bot, side )
			ok = FlowstateDummy_PlayStrafeAct( bot, FlowstateHard_SideAct( side, crouch ), FlowstateHard_PickStrafeDuration(), FlowstateHard_PickPlaybackRate( bot ), true )
			if ( !ok && IsValid( bot ) )
			{
				lastSide = FlowstateDummy_UnstuckReverse( bot, side, target )
				if ( lastSide != side )
					flipStreak++
			}
			else
			{
				// same-side holds break the ADAD loop
				lastSide = side
				flipStreak = 0
				unstuckStreak = 0
				if ( IsValid( bot ) )
					oscWindowOrigin = bot.GetOrigin()
			}
		}
		else if ( roll < 60 )
		{
			// Crouch lateral only (height change + lateral)
			int side = FlowstateDummy_PickOpenSide( bot, ( lastSide == 0 ) ? 1 : 0 )
			ok = FlowstateDummy_PlayStrafeAct( bot, FlowstateHard_SideAct( side, true ), FlowstateHard_PickStrafeDuration(), rate, true )
			if ( !ok && IsValid( bot ) )
			{
				lastSide = FlowstateDummy_UnstuckReverse( bot, side, target )
				if ( lastSide != side )
					flipStreak++
			}
			else
			{
				if ( side != lastSide )
					flipStreak++
				else
					flipStreak = 0
				lastSide = side
				unstuckStreak = 0
			}
		}
		else
		{
			// Default: same-side bias so ScriptedPlay keeps cycling (alternate restarts = "low FPS")
			int preferred = lastSide
			if ( RandomInt( 100 ) < 28 )
				preferred = ( lastSide == 0 ) ? 1 : 0
			int side = FlowstateDummy_PickOpenSide( bot, preferred )
			bool crouch = ( RandomInt( 100 ) < 12 )
			float dur = FlowstateHard_PickStrafeDuration()

			ok = FlowstateDummy_PlayStrafeAct( bot, FlowstateHard_SideAct( side, crouch ), dur, rate, true )
			if ( !ok && IsValid( bot ) )
			{
				unstuckStreak++
				if ( unstuckStreak >= FLOWSTATE_HARD_UNSTUCK_DEPTH_AFTER )
				{
					if ( !FlowstateHard_TryDepthStep( bot, rate ) )
						lastSide = FlowstateHard_CommitSide( bot, side, target, crouch )
					unstuckStreak = 0
					flipStreak = 0
					if ( IsValid( bot ) )
						oscWindowOrigin = bot.GetOrigin()
				}
				else
				{
					lastSide = FlowstateDummy_UnstuckReverse( bot, side, target )
					if ( lastSide != side )
						flipStreak++
				}
			}
			else
			{
				if ( side != lastSide )
					flipStreak++
				else
					flipStreak = 0
				lastSide = side
				unstuckStreak = 0
			}
		}

		// Refresh travel window when dummy has actually left the buzz zone
		if ( IsValid( bot ) && Distance2DSqr( bot.GetOrigin(), oscWindowOrigin ) >= FLOWSTATE_HARD_OSC_TRAVEL_SQR )
		{
			oscWindowOrigin = bot.GetOrigin()
			if ( flipStreak > 0 )
				flipStreak--
		}
	}
}

//-----------------------------------------------------------------------------
// Purpose: Spawn a Flowstate-style strafing training dummy at crosshair.
//          Recreates StartStraferDummyChallenge spawn+strafe setup as a one-shot
//          crosshair spawn (same pattern as other DEV_Spawn*AtCrosshair helpers).
//-----------------------------------------------------------------------------
entity function DEV_SpawnFlowstateDummyAtCrosshair( entity player, int shieldLevel = -1 )
{
	if ( !IsValid( player ) )
	{
		printt( "[FlowstateDummy] DEV_SpawnFlowstateDummyAtCrosshair: invalid player" )
		return null
	}

	if ( shieldLevel < 0 )
		shieldLevel = AimTrainer_ResolveDummyShieldLevel( player )

	vector origin = GetPlayerCrosshairOrigin( player )
	vector eyeAngles = player.EyeAngles()
	vector angles = <0.0, ( eyeAngles.y + 180.0 ), 0.0>

	// RegisterDummy -> AimTrainer_EnterMode (infinite ammo / autoreload kill / dyn stats)
	entity npc = FlowstateDummy_SpawnAt( player, origin, angles, shieldLevel, FLOWSTATE_STRAFE_WAIT_MIN, FLOWSTATE_STRAFE_WAIT_MAX )
	if ( !IsValid( npc ) )
		return null

	printt( "[FlowstateDummy] Spawned Flowstate Dummy at crosshair " + string( origin ) )
	return npc
}

entity function DEV_SpawnFlowstateHardDummyAtCrosshair( entity player, int shieldLevel = -1 )
{
	if ( !IsValid( player ) )
	{
		printt( "[FlowstateDummy] DEV_SpawnFlowstateHardDummyAtCrosshair: invalid player" )
		return null
	}

	if ( shieldLevel < 0 )
		shieldLevel = AimTrainer_ResolveDummyShieldLevel( player )

	vector origin = GetPlayerCrosshairOrigin( player )
	vector eyeAngles = player.EyeAngles()
	vector angles = <0.0, ( eyeAngles.y + 180.0 ), 0.0>

	entity npc = FlowstateDummy_SpawnAt( player, origin, angles, shieldLevel, FLOWSTATE_STRAFE_HARD_WAIT_MIN, FLOWSTATE_STRAFE_HARD_WAIT_MAX, true )
	if ( !IsValid( npc ) )
		return null

	printt( "[FlowstateDummy] Spawned Flowstate Hard Dummy at crosshair " + string( origin ) )
	return npc
}

// Legacy names -> freeroam Autospawn challenges (front-of-player, timed session).
void function DEV_SpawnFlowstateAutospawnDummyAtCrosshair( entity player, int shieldLevel = 3 )
{
	DEV_AimFreeroam_Autospawn( player )
}

void function DEV_SpawnFlowstateHardAutospawnDummyAtCrosshair( entity player, int shieldLevel = 3 )
{
	DEV_AimFreeroam_AutospawnHard( player )
}

// Static dummies = red (skin 1). Strafers = random from working skins.
// Skins: 1 red, 3 blue, 4 black, 6 purple
void function Dummy_SetStraferSkin( entity npc )
{
	if ( !IsValid( npc ) )
		return

	array<int> skins = [ 1, 3, 4, 6 ]
	npc.SetSkin( skins[ RandomInt( skins.len() ) ] )
}

entity function FlowstateDummy_SpawnAt( entity player, vector origin, vector angles, int shieldLevel, float waitMin = FLOWSTATE_STRAFE_WAIT_MIN, float waitMax = FLOWSTATE_STRAFE_WAIT_MAX, bool smartHard = false )
{
	entity npc = SpawnNPCTrainingDummy( origin, angles, shieldLevel )
	if ( !IsValid( npc ) )
	{
		printt( "[FlowstateDummy] FlowstateDummy_SpawnAt: spawn failed" )
		return null
	}

	// Plant feet immediately (training spawn has a small Z lift + delayed ground thread).
	vector groundPos = GetGroundPosition( npc.GetOrigin() + <0, 0, 32>, npc.GetOrigin() + <0, 0, -256>, [ npc ] ).endPos
	if ( !TrySetOriginInWorld( npc, groundPos ) )
	{
		npc.Destroy()
		return null
	}
	// Kill spawn push-down: its 10Hz SetOrigin fights scripted root-motion (reads as low FPS)
	npc.Signal( "StopPushNPCDownToGround" )

	if ( !AimTrainer_RegisterDummy( player, npc ) )
	{
		npc.Destroy()
		return null
	}

	if ( IsValid( player ) )
		AddToUltimateRealm( player, npc )

	npc.EnableNPCFlag( NPC_IGNORE_ALL | NPC_DISABLE_SENSING | NPC_NO_WEAPON_DROP )
	npc.SetTitle( "" )
	npc.SetAimAssistAllowed( true )
	Dummy_SetStraferSkin( npc )
	FlowstateDummy_ApplyOwnerPrefs( player, npc )
	StartBotStrafeMovementPattern( npc, 0.0, player, waitMin, waitMax, smartHard )
	return npc
}

// Fixed-origin loop kept for any external callers; freeroam Autospawn uses AimFreeroam_AutospawnLoop.
void function FlowstateAutospawnDummyLoop( entity player, vector origin, vector angles, int shieldLevel, float waitMin, float waitMax, bool smartHard = false )
{
	if ( IsValid( player ) )
	{
		player.EndSignal( "OnDestroy" )
		player.EndSignal( "AimFreeroam_Stop" )
	}

	while ( true )
	{
		entity npc = FlowstateDummy_SpawnAt( player, origin, angles, shieldLevel, waitMin, waitMax, smartHard )
		if ( !IsValid( npc ) )
		{
			wait 0.5
			continue
		}

		printt( "[FlowstateDummy] Autospawn dummy live at " + string( origin ) + " hard=" + string( smartHard ) )
		WaitSignal( npc, "OnDeath", "OnDestroy" )
		wait 0.2
	}
}

// Autospawn freeroam: one strafer in front of the player; respawn after kill (safe plant each time).
const float AIM_FREEROAM_AUTOSPAWN_DIST = 400.0

// asChallenge: timed run with the aim-trainer clock and results. Otherwise the
// strafer just keeps respawning until the player clears it.
void function DEV_AimFreeroam_Autospawn( entity player, bool asChallenge = false )
{
	if ( !IsValid( player ) )
		return

	AimTrainer_StopPlayerSession( player )
	player.p.aimTrainerFreeroamMode = AIMTRAINER_FREEROAM_AUTOSPAWN
	if ( asChallenge )
		AimTrainer_BeginTimedChallenge( player, true )
	else
		AimTrainer_EnterMode( player )
	AimFreeroam_StartAutospawnLoop( player, false )
	printt( format( "[AimFreeroam] Autospawn started for %s challenge=%s", player.GetPlayerName(), string( asChallenge ) ) )
}

void function DEV_AimFreeroam_AutospawnHard( entity player, bool asChallenge = false )
{
	if ( !IsValid( player ) )
		return

	AimTrainer_StopPlayerSession( player )
	player.p.aimTrainerFreeroamMode = AIMTRAINER_FREEROAM_AUTOSPAWN_HARD
	if ( asChallenge )
		AimTrainer_BeginTimedChallenge( player, true )
	else
		AimTrainer_EnterMode( player )
	AimFreeroam_StartAutospawnLoop( player, true )
	printt( format( "[AimFreeroam] Autospawn Hard started for %s challenge=%s", player.GetPlayerName(), string( asChallenge ) ) )
}

// Legend body pref owns the autospawn shape: fake-player strafers instead of NPC dummies.
void function AimFreeroam_StartAutospawnLoop( entity player, bool smartHard )
{
	if ( !IsValid( player ) )
		return
	bool legendBody = false
	try
	{
		legendBody = LegendBot_GetBodyIsLegend( player )
	}
	catch ( eBody )
	{
		legendBody = false
	}
	if ( legendBody )
		thread LegendBot_AutospawnLoop( player, smartHard )
	else
		thread AimFreeroam_AutospawnLoop( player, smartHard )
}

void function AimFreeroam_AutospawnLoop( entity player, bool smartHard )
{
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDeath" )
	player.EndSignal( "AimFreeroam_Stop" )

	OnThreadEnd(
		function() : ()
		{
			printt( "[AimFreeroam] Autospawn ended" )
		}
	)

	// Hold spawns until the pre-start description window is over.
	AimTrainer_WaitForIntro( player )

	float waitMin = smartHard ? FLOWSTATE_STRAFE_HARD_WAIT_MIN : FLOWSTATE_STRAFE_WAIT_MIN
	float waitMax = smartHard ? FLOWSTATE_STRAFE_HARD_WAIT_MAX : FLOWSTATE_STRAFE_WAIT_MAX

	while ( IsValid( player ) )
	{
		if ( AimTrainer_GetBudgetRemaining() <= 0 )
		{
			wait 0.5
			continue
		}

		vector origin = player.GetOrigin() + AnglesToForward( player.GetAngles() ) * AIM_FREEROAM_AUTOSPAWN_DIST
		vector groundPos = GetGroundPosition( origin + <0, 0, 32>, origin + <0, 0, -512>, [ player ] ).endPos
		if ( player.p.aimTrainerFixedSpawn )
			groundPos = player.p.aimTrainerFixedSpawnPos
		vector angles = <0.0, VectorToAngles( player.GetOrigin() - groundPos ).y, 0.0>

		entity npc = FlowstateDummy_SpawnAt( player, groundPos, angles, AimTrainer_ResolveDummyShieldLevel( player ), waitMin, waitMax, smartHard )
		if ( !IsValid( npc ) )
		{
			wait 0.5
			continue
		}

		printt( format( "[AimFreeroam] Autospawn dummy live hard=%s @ %s", string( smartHard ), string( groundPos ) ) )
		WaitSignal( npc, "OnDeath", "OnDestroy" )
		wait 0.2
	}
}

// -----------------------------------------------------------------------------
// Freeroam aim scenarios (shared shape with fs_aimtrainer -- player-relative, no arena)
// Target Switch = StartSwapFocusDummyChallenge, Popcorn = CreateDummyPopcornChallenge
// -----------------------------------------------------------------------------
const int AIM_FREEROAM_TARGET_SWITCH_MAX = 4
const int AIM_FREEROAM_POPCORN_MAX = 7
const float AIM_FREEROAM_RING_RADIUS = 400.0
const float AIM_FREEROAM_POPCORN_RADIUS = 350.0
const float AIM_FREEROAM_MAX_DIST = 3000.0
// Target switch: FOV-cone spawns (not full ring) so kills/damage land on-screen.
// half-angle matches PlayerCanSeePos degrees (view-vector cone, not full horizontal FOV).
const float AIM_FREEROAM_TS_FOV_HALF_DEG = 35.0
const float AIM_FREEROAM_TS_RADIUS_MIN = 280.0
const float AIM_FREEROAM_TS_RADIUS_MAX = 520.0
// Min planar separation so the 4 stay spread (was 150 -- too tight in FOV).
const float AIM_FREEROAM_TS_MIN_SEP = 280.0
const float AIM_FREEROAM_TS_MAX_Z_DELTA = 350.0
const int AIM_FREEROAM_TS_SPAWN_TRIES = 32
// Yaw jitter inside each FOV sector when filling slot N of MAX.
const float AIM_FREEROAM_TS_SECTOR_JITTER = 6.0
// Target switch: normal playback (matches Flowstate StartSwapFocusDummy ~0.4s phases)
const float AIM_FREEROAM_TS_PLAYRATE = 1.0
const float AIM_FREEROAM_TS_PHASE = 0.4
// Popcorn: hop when origin is this close to ground (Flowstate floor delta < 50)
const float AIM_FREEROAM_POPCORN_GROUND_Z = 50.0
// Min time between hops -- stuck dummies used to WaitFrame-spam JumpPad SFX
const float AIM_FREEROAM_POPCORN_HOP_COOLDOWN = 0.35
// Consecutive near-ground hops with almost no travel => stuck (kill + open-space respawn)
const int AIM_FREEROAM_POPCORN_STUCK_HOPS = 4
const float AIM_FREEROAM_POPCORN_STUCK_DIST = 40.0
const float AIM_FREEROAM_POPCORN_MIN_SEP = 180.0
const float AIM_FREEROAM_POPCORN_MAX_Z_DELTA = 350.0
const int AIM_FREEROAM_POPCORN_SPAWN_TRIES = 24
// Floating Target: one immortal dummy ahead of player (Flowstate StartFloatingTargetChallenge)
const float AIM_FREEROAM_FLOATING_DIST = 300.0
// Skydiving: up to 4 divers (Flowstate StartSkyDiveChallenge)
const int AIM_FREEROAM_SKYDIVING_MAX = 4
const float AIM_FREEROAM_SKY_HIGH_RADIUS = 200.0
const float AIM_FREEROAM_SKY_GROUND_RADIUS = 400.0
const float AIM_FREEROAM_SKY_HEIGHT = 3000.0
const float AIM_FREEROAM_SKY_DIVE_TIME = 4.6
const int AIM_FREEROAM_SKY_RING_PTS = 50
// Smoothbot: curved path inside a box in front of the player.
// Soft wall fields + mild steering = continuous curves (not linear hard bounces).
// Subtle speed sine modulation. Overlapping NonPhysicsMoveTo for clean glide.
const float AIM_FREEROAM_SMOOTH_CENTER_DEPTH = 550.0
// Half-extents of the tracking box (relatively big, still contained)
const float AIM_FREEROAM_SMOOTH_HALF_RIGHT = 300.0
const float AIM_FREEROAM_SMOOTH_HALF_UP = 200.0
const float AIM_FREEROAM_SMOOTH_HALF_DEPTH = 180.0
// Soft wall band -- start curving away before the hard edge
const float AIM_FREEROAM_SMOOTH_WALL_MARGIN = 90.0
const float AIM_FREEROAM_SMOOTH_WALL_FORCE = 520.0
// Base speed + subtle variation (±SPEED_VAR fraction)
const float AIM_FREEROAM_SMOOTH_SPEED = 155.0
const float AIM_FREEROAM_SMOOTH_SPEED_VAR = 0.14
const float AIM_FREEROAM_SMOOTH_SPEED_FREQ = 0.35
// Mild random steering for organic mid-box curves (units/s^2 scale)
const float AIM_FREEROAM_SMOOTH_STEER = 55.0
const float AIM_FREEROAM_SMOOTH_STEER_RETARGET = 1.6
// Overlapping mover (blend > reissue)
const float AIM_FREEROAM_SMOOTH_BLEND = 0.40
const float AIM_FREEROAM_SMOOTH_REISSUE = 0.10
const float AIM_FREEROAM_SMOOTH_VIEW_FOLLOW = 0.12
const int AIM_FREEROAM_SMOOTH_PHYS_STEPS = 4

// Legacy name kept for call sites that still untrack; ownership is AimTrainer_RegisterDummy.
void function AimFreeroam_TrackEnt( entity ent )
{
	// No-op: budget/owner registry is authoritative.
}

void function AimFreeroam_UntrackEnt( entity ent )
{
	// No-op: AimTrainer_UnregisterDummy runs on OnDestroy.
}

// Stops only THIS player's freeroam/challenge/dummies (multiplayer-safe).
void function DEV_AimFreeroam_StopAll( entity player )
{
	if ( !IsValid( player ) || !player.IsPlayer() )
	{
		printt( "[AimFreeroam] StopAll requires a player" )
		return
	}
	AimTrainer_StopPlayerSession( player )
	printt( format( "[AimFreeroam] Stop session for %s (budget %d/%d)",
		player.GetPlayerName(), AimTrainer_GetDummyCount(), AIMTRAINER_DUMMY_BUDGET ) )
}

void function DEV_AimFreeroam_TargetSwitch( entity player )
{
	if ( !IsValid( player ) )
		return

	// Replace only this player's session -- other players keep their dummies.
	AimTrainer_StopPlayerSession( player )
	player.p.aimTrainerFreeroamMode = AIMTRAINER_FREEROAM_TARGET_SWITCH
	AimTrainer_BeginTimedChallenge( player, true )
	thread AimFreeroam_TargetSwitchLoop( player )
	printt( format( "[AimFreeroam] Target Switch started for %s", player.GetPlayerName() ) )
}

void function DEV_AimFreeroam_Popcorn( entity player )
{
