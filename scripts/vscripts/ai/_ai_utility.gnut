// Kill this player's freeroam threads + dummies, then re-enter the remembered scenario.
// Does NOT touch challenge timer / client HUD (caller owns that).
void function AimFreeroam_RestartScenario( entity player )
{
	if ( !IsValid( player ) || !player.IsPlayer() )
		return

	int mode = player.p.aimTrainerFreeroamMode
	// Caller (RestartChallengeFull) already FX-despawned; this is the safety for other entry points.
	AimTrainer_DestroyPlayerDummies( player )
	LegendBot_KickAll( player )
	player.Signal( "AimFreeroam_Stop" )

	if ( mode == AIMTRAINER_FREEROAM_TARGET_SWITCH )
	{
		thread AimFreeroam_TargetSwitchLoop( player )
		printt( format( "[AimFreeroam] Restart Target Switch for %s", player.GetPlayerName() ) )
	}
	else if ( mode == AIMTRAINER_FREEROAM_POPCORN )
	{
		thread AimFreeroam_PopcornLoop( player )
		printt( format( "[AimFreeroam] Restart Popcorn for %s", player.GetPlayerName() ) )
	}
	else if ( mode == AIMTRAINER_FREEROAM_FLOATING_TARGET )
	{
		printt( format( "[AimFreeroam] Restart Floating Target disabled for %s", player.GetPlayerName() ) )
	}
	else if ( mode == AIMTRAINER_FREEROAM_SKYDIVING )
	{
		thread AimFreeroam_SkydivingLoop( player )
		printt( format( "[AimFreeroam] Restart Skydiving for %s", player.GetPlayerName() ) )
	}
	else if ( mode == AIMTRAINER_FREEROAM_SMOOTHBOT )
	{
		printt( format( "[AimFreeroam] Restart Smoothbot disabled for %s", player.GetPlayerName() ) )
	}
	else if ( mode == AIMTRAINER_FREEROAM_AUTOSPAWN )
	{
		AimFreeroam_StartAutospawnLoop( player, false )
		printt( format( "[AimFreeroam] Restart Autospawn for %s", player.GetPlayerName() ) )
	}
	else if ( mode == AIMTRAINER_FREEROAM_AUTOSPAWN_HARD )
	{
		AimFreeroam_StartAutospawnLoop( player, true )
		printt( format( "[AimFreeroam] Restart Autospawn Hard for %s", player.GetPlayerName() ) )
	}
	else
	{
		printt( format( "[AimFreeroam] Restart: no freeroam mode (dummies cleared) for %s", player.GetPlayerName() ) )
	}
}

// Up to 4 standing strafers in the player's FOV cone; refill on kill (SwapFocus shape).
// Spawns use EyeAngles + PlayerCanSeePos so damage/kills score on-screen.
void function AimFreeroam_TargetSwitchLoop( entity player )
{
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDeath" )
	player.EndSignal( "AimFreeroam_Stop" )

	OnThreadEnd(
		function() : ()
		{
			printt( "[AimFreeroam] Target Switch ended" )
		}
	)

	// Hold spawns until the pre-start description window is over.
	AimTrainer_WaitForIntro( player )

	array<entity> live = []

	while ( IsValid( player ) )
	{
		// Drop dead / invalid
		for ( int i = live.len() - 1; i >= 0; i-- )
		{
			if ( !IsValid( live[i] ) || !IsAlive( live[i] ) )
			{
				AimFreeroam_UntrackEnt( live[i] )
				live.remove( i )
			}
		}

		while ( live.len() < AIM_FREEROAM_TARGET_SWITCH_MAX )
		{
			if ( AimTrainer_GetBudgetRemaining() <= 0 )
				break

			vector pos = AimFreeroam_PickTargetSwitchFovPos( player, live )
			vector angles = <0.0, VectorToAngles( player.GetOrigin() - pos ).y, 0.0>
			// Shield tier follows the FR shield setting in FR, else the player's Lab armor pref.
			// SetNPCShieldLevel inside the spawn owns skin + pool + grade together.
			entity npc = SpawnNPCTrainingDummy( pos, angles, AimTrainer_ResolveDummyShieldLevel( player ) )
			if ( !IsValid( npc ) )
				break

			vector groundPos = GetGroundPosition( npc.GetOrigin() + <0, 0, 32>, npc.GetOrigin() + <0, 0, -256>, [ npc ] ).endPos
			// Reject if ground snap left FOV (cliff/edge) -- try next slot next frame.
			if ( !PlayerCanSeePos( player, groundPos + <0, 0, 48>, false, AIM_FREEROAM_TS_FOV_HALF_DEG ) )
			{
				npc.Destroy()
				break
			}

			if ( !TrySetOriginInWorld( npc, groundPos ) )
			{
				npc.Destroy()
				break
			}
			// Spawn push-down 10Hz SetOrigin fights scripted root-motion (same fix as FlowstateDummy_SpawnAt)
			npc.Signal( "StopPushNPCDownToGround" )
			if ( !AimTrainer_RegisterDummy( player, npc ) )
			{
				npc.Destroy()
				break
			}
			if ( IsValid( player ) )
				AddToUltimateRealm( player, npc )
			npc.EnableNPCFlag( NPC_IGNORE_ALL | NPC_DISABLE_SENSING | NPC_NO_WEAPON_DROP )
			npc.SetTitle( "" )
			npc.SetAimAssistAllowed( true )

			live.append( npc )
			thread AimFreeroam_TargetSwitchWatcher( npc, player, live )
		}

		WaitFrame()
	}
}

// Ground points inside the player's view cone (same primitives as Smoothbot / PlayerCanSeePos).
// Spreads across FOV sectors by live count so the pack is not clustered on one side.
vector function AimFreeroam_PickTargetSwitchFovPos( entity player, array<entity> live )
{
	vector playerPos = player.GetOrigin()
	float viewYaw = player.EyeAngles().y
	array<entity> ignoreNone = []

	// Slot 0..MAX-1 maps to even yaw lanes across +/- FOV half.
	int slot = live.len()
	if ( slot < 0 )
		slot = 0
	if ( slot >= AIM_FREEROAM_TARGET_SWITCH_MAX )
		slot = AIM_FREEROAM_TARGET_SWITCH_MAX - 1

	float sectorW = ( AIM_FREEROAM_TS_FOV_HALF_DEG * 2.0 ) / float( AIM_FREEROAM_TARGET_SWITCH_MAX )
	float sectorCenter = -AIM_FREEROAM_TS_FOV_HALF_DEG + sectorW * ( float( slot ) + 0.5 )
	// Depth band also by slot so near/far alternates a bit (0,2 nearer-ish; 1,3 farther-ish).
	float radiusBias = ( ( slot % 2 ) == 0 ) ? 0.35 : 0.65
	float radiusMid = AIM_FREEROAM_TS_RADIUS_MIN + ( AIM_FREEROAM_TS_RADIUS_MAX - AIM_FREEROAM_TS_RADIUS_MIN ) * radiusBias

	for ( int attempt = 0; attempt < AIM_FREEROAM_TS_SPAWN_TRIES; attempt++ )
	{
		// Prefer sector first; after half the tries, open the full FOV still enforcing min sep.
		float yawOff
		float radius
		if ( attempt < AIM_FREEROAM_TS_SPAWN_TRIES / 2 )
		{
			yawOff = sectorCenter + RandomFloatRange( -AIM_FREEROAM_TS_SECTOR_JITTER, AIM_FREEROAM_TS_SECTOR_JITTER )
			radius = radiusMid + RandomFloatRange( -40.0, 40.0 )
		}
		else
		{
			yawOff = RandomFloatRange( -AIM_FREEROAM_TS_FOV_HALF_DEG, AIM_FREEROAM_TS_FOV_HALF_DEG )
			radius = RandomFloatRange( AIM_FREEROAM_TS_RADIUS_MIN, AIM_FREEROAM_TS_RADIUS_MAX )
		}

		if ( radius < AIM_FREEROAM_TS_RADIUS_MIN )
			radius = AIM_FREEROAM_TS_RADIUS_MIN
		if ( radius > AIM_FREEROAM_TS_RADIUS_MAX )
			radius = AIM_FREEROAM_TS_RADIUS_MAX

		vector raw = playerPos + AnglesToForward( <0.0, viewYaw + yawOff, 0.0> ) * radius
		vector ground = GetGroundPosition( raw + <0, 0, 128>, raw + <0, 0, -1024>, ignoreNone ).endPos

		if ( fabs( ground.z - playerPos.z ) > AIM_FREEROAM_TS_MAX_Z_DELTA )
			continue

		// Chest-height FOV gate -- EyePosition + GetViewVector inside PlayerCanSeePos.
		if ( !PlayerCanSeePos( player, ground + <0, 0, 48>, false, AIM_FREEROAM_TS_FOV_HALF_DEG ) )
			continue

		bool crowded = false
		foreach ( entity d in live )
		{
			if ( IsValid( d ) && Distance( d.GetOrigin(), ground ) < AIM_FREEROAM_TS_MIN_SEP )
			{
				crowded = true
				break
			}
		}
		if ( crowded )
			continue

		vector mins = <-18, -18, 0>
		vector maxs = <18, 18, 72>
		TraceResults hull = TraceHull( ground + <0, 0, 4>, ground + <0, 0, 8>, mins, maxs, ignoreNone, TRACE_MASK_NPCSOLID, TRACE_COLLISION_GROUP_NONE )
		if ( hull.startSolid || hull.fraction < 1.0 )
			continue

		return ground
	}

	// Fallback: that slot's sector center at mid radius (still spread, still forward).
	vector fallback = playerPos + AnglesToForward( <0.0, viewYaw + sectorCenter, 0.0> ) * radiusMid
	return GetGroundPosition( fallback + <0, 0, 128>, fallback + <0, 0, -1024>, ignoreNone ).endPos
}

void function AimFreeroam_TargetSwitchWatcher( entity ai, entity player, array<entity> live )
{
	ai.EndSignal( "OnDeath" )
	ai.EndSignal( "OnDestroy" )
	if ( IsValid( player ) )
	{
		player.EndSignal( "OnDestroy" )
		player.EndSignal( "AimFreeroam_Stop" )
	}

	// Do not Destroy here -- AimFreeroam_Stop races Hold-R / timeout / Finish.
	// Session cleanup owns despawn FX via AimTrainer_DestroyPlayerDummies.
	OnThreadEnd(
		function() : ( ai, live )
		{
			live.removebyvalue( ai )
		}
	)

	while ( IsValid( ai ) && IsValid( player ) )
	{
		FlowstateDummy_FaceTargetYawOnly( ai, player )

		if ( Distance( ai.GetOrigin(), player.GetOrigin() ) > AIM_FREEROAM_MAX_DIST )
		{
			ai.Destroy()
			break
		}

		// checkStuck false -- stuck slices + 1.0 playrate read as slow-mo on these acts
		int random = RandomIntRangeInclusive( 1, 6 )
		if ( random <= 3 )
		{
			FlowstateDummy_PlayStrafeAct( ai, "ACT_SPRINT_RIGHT", AIM_FREEROAM_TS_PHASE, AIM_FREEROAM_TS_PLAYRATE, false )
			if ( !IsValid( ai ) )
				break
			FlowstateDummy_PlayStrafeAct( ai, "ACT_SPRINT_LEFT", AIM_FREEROAM_TS_PHASE, AIM_FREEROAM_TS_PLAYRATE, false )
		}
		else
		{
			FlowstateDummy_PlayStrafeAct( ai, "ACT_SPRINT_LEFT", AIM_FREEROAM_TS_PHASE, AIM_FREEROAM_TS_PLAYRATE, false )
			if ( !IsValid( ai ) )
				break
			FlowstateDummy_PlayStrafeAct( ai, "ACT_SPRINT_RIGHT", AIM_FREEROAM_TS_PHASE, AIM_FREEROAM_TS_PLAYRATE, false )
		}
	}
}

// Radial bounce dummies -- Flowstate CreateDummyPopcornChallenge: SetVelocity on ground only.
// Engine gravity owns the arc. Stuck hops are culled; loop respawns into open space.
void function AimFreeroam_PopcornLoop( entity player )
{
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDeath" )
	player.EndSignal( "AimFreeroam_Stop" )

	OnThreadEnd(
		function() : ()
		{
			printt( "[AimFreeroam] Popcorn ended" )
		}
	)

	// Hold spawns until the pre-start description window is over.
	AimTrainer_WaitForIntro( player )

	array<entity> live = []

	while ( IsValid( player ) )
	{
		for ( int i = live.len() - 1; i >= 0; i-- )
		{
			if ( !IsValid( live[i] ) || !IsAlive( live[i] ) )
			{
				AimFreeroam_UntrackEnt( live[i] )
				live.remove( i )
			}
		}

		while ( live.len() < AIM_FREEROAM_POPCORN_MAX )
		{
			if ( AimTrainer_GetBudgetRemaining() <= 0 )
				break
			entity npc = AimFreeroam_SpawnPopcornDummy( player, live )
			if ( !IsValid( npc ) )
				break
			live.append( npc )
			thread AimFreeroam_PopcornBounceThink( npc, player )
		}

		WaitFrame()
	}
}

// Prefer clear ring slots around the player (sep from live, flat ground, free hull).
vector function AimFreeroam_PickPopcornOpenPos( entity player, array<entity> live )
{
	vector playerPos = player.GetOrigin()
	array<entity> ignoreNone = []

	for ( int attempt = 0; attempt < AIM_FREEROAM_POPCORN_SPAWN_TRIES; attempt++ )
	{
		float radius = RandomFloatRange( AIM_FREEROAM_POPCORN_RADIUS * 0.7, AIM_FREEROAM_POPCORN_RADIUS * 1.35 )
		float ang = RandomFloat( 1.0 ) * 2.0 * PI
		vector raw = playerPos + radius * <sin( ang ), cos( ang ), 0.0>
		vector ground = GetGroundPosition( raw + <0, 0, 128>, raw + <0, 0, -1024>, ignoreNone ).endPos

		if ( fabs( ground.z - playerPos.z ) > AIM_FREEROAM_POPCORN_MAX_Z_DELTA )
			continue

		bool crowded = false
		foreach ( entity d in live )
		{
			if ( IsValid( d ) && Distance( d.GetOrigin(), ground ) < AIM_FREEROAM_POPCORN_MIN_SEP )
			{
				crowded = true
				break
			}
		}
		if ( crowded )
			continue

		// Hull freeness at stand height (reject solid pockets that pin hop velocity)
		vector mins = <-18, -18, 0>
		vector maxs = <18, 18, 72>
		TraceResults hull = TraceHull( ground + <0, 0, 4>, ground + <0, 0, 8>, mins, maxs, ignoreNone, TRACE_MASK_NPCSOLID, TRACE_COLLISION_GROUP_NONE )
		if ( hull.startSolid || hull.fraction < 1.0 )
			continue

		return ground
	}

	// Fallback: random ring, ground snap only
	float r = RandomFloat( 1.0 ) * 2.0 * PI
	vector fallback = playerPos + AIM_FREEROAM_POPCORN_RADIUS * <sin( r ), cos( r ), 0.0>
	return GetGroundPosition( fallback + <0, 0, 128>, fallback + <0, 0, -1024>, ignoreNone ).endPos
}

entity function AimFreeroam_SpawnPopcornDummy( entity player, array<entity> live )
{
	vector groundPos = AimFreeroam_PickPopcornOpenPos( player, live )
	vector angles = <0.0, VectorToAngles( player.GetOrigin() - groundPos ).y, 0.0>

	// autoPlantGround=false -- plant thread SetOrigin fights native hop velocity.
	entity npc = SpawnNPCTrainingDummy( groundPos, angles, AimTrainer_ResolveDummyShieldLevel( player ), false, false )
	if ( !IsValid( npc ) )
		return null

	npc.Signal( "StopPushNPCDownToGround" )
	npc.Signal( "JumpPad_DummieInAir" )
	// One-time ground plant at spawn only; bounce think never SetOrigin after this.
	if ( !TrySetOriginInWorld( npc, groundPos ) )
	{
		npc.Destroy()
		return null
	}
	npc.SetAngles( angles )
	npc.SetAimAssistAllowed( true )
	npc.EnableNPCFlag( NPC_IGNORE_ALL | NPC_DISABLE_SENSING | NPC_NO_WEAPON_DROP )
	npc.SetTitle( "" )
	Dummy_SetStraferSkin( npc )

	if ( !AimTrainer_RegisterDummy( player, npc ) )
	{
		npc.Destroy()
		return null
	}
	if ( IsValid( player ) )
		AddToUltimateRealm( player, npc )

	return npc
}

// WaitFrame near-ground check, then SetVelocity hop (Flowstate CreateDummyPopcornChallenge).
// Cooldown + stuck cull stop permanent JumpPad_LaunchPlayer_3p spam when velocity cannot free the dummy.
void function AimFreeroam_PopcornBounceThink( entity ai, entity player )
{
	ai.EndSignal( "OnDeath" )
	ai.EndSignal( "OnDestroy" )
	if ( IsValid( player ) )
	{
		player.EndSignal( "OnDestroy" )
		player.EndSignal( "AimFreeroam_Stop" )
	}

	// No OnThreadEnd Destroy -- AimFreeroam_Stop races Hold-R / timeout / Finish.
	// Session cleanup owns despawn FX via AimTrainer_DestroyPlayerDummies.

	int side = CoinFlip() ? 1 : -1
	float lastHopTime = -999.0
	vector lastHopOrigin = ai.GetOrigin()
	int stuckHops = 0

	while ( IsValid( ai ) && IsValid( player ) )
	{
		WaitFrame()
		if ( !IsValid( ai ) || !IsValid( player ) )
			break

		if ( Distance( ai.GetOrigin(), player.GetOrigin() ) > AIM_FREEROAM_MAX_DIST )
			break

		vector ground = GetGroundPosition( ai.GetOrigin() + <0, 0, 128>, ai.GetOrigin() + <0, 0, -1024>, [ ai ] ).endPos
		float heightAbove = ai.GetOrigin().z - ground.z

		// Airborne hop success -- clear stuck streak
		if ( heightAbove >= AIM_FREEROAM_POPCORN_GROUND_Z )
		{
			stuckHops = 0
			continue
		}

		// Still near ground: rate-limit hops (stuck = ground forever without this)
		if ( Time() - lastHopTime < AIM_FREEROAM_POPCORN_HOP_COOLDOWN )
			continue

		// Stuck: successive hops while barely moving in XY
		if ( Distance2D( ai.GetOrigin(), lastHopOrigin ) < AIM_FREEROAM_POPCORN_STUCK_DIST )
			stuckHops++
		else
			stuckHops = 0

		if ( stuckHops >= AIM_FREEROAM_POPCORN_STUCK_HOPS )
		{
			printt( format( "[AimFreeroam] Popcorn stuck cull at %s (hops=%d)", string( ai.GetOrigin() ), stuckHops ) )
			ai.Destroy()
			break
		}

		lastHopOrigin = ai.GetOrigin()
		lastHopTime = Time()

		// Near ground: face player, apply launch impulse, engine physics does the rest.
		vector toPlayer = <player.GetOrigin().x, player.GetOrigin().y, ground.z> - ai.GetOrigin()
		vector angles2 = VectorToAngles( toPlayer )
		ai.SetAngles( <0, angles2.y, 0> )

		if ( Distance( player.GetOrigin(), ai.GetOrigin() ) > 1500.0 )
		{
			ai.SetVelocity( AnglesToForward( angles2 ) * 500.0 + AnglesToUp( angles2 ) * RandomFloatRange( 512.0, 1024.0 ) )
			EmitSoundOnEntity( ai, "JumpPad_LaunchPlayer_3p" )
			continue
		}

		if ( CoinFlip() )
			side = 1
		else
			side = -1

		int random2 = RandomIntRangeInclusive( 1, 5 )
		if ( random2 >= 4 )
			ai.SetVelocity( AnglesToForward( angles2 ) * 128.0 + AnglesToUp( angles2 ) * RandomFloatRange( 512.0, 1024.0 ) )
		else
			ai.SetVelocity( ( AnglesToRight( angles2 ) * RandomFloatRange( 128.0, 256.0 ) * float( side ) ) + AnglesToUp( angles2 ) * RandomFloatRange( 512.0, 1024.0 ) )

		EmitSoundOnEntity( ai, "JumpPad_LaunchPlayer_3p" )
	}
}

vector function AimFreeroam_PickRingPos( entity player, array<entity> live, float radius )
{
	array<vector> candidates = []
	for ( int i = 0; i < 20; i++ )
	{
		float r = float( i ) / 20.0 * 2.0 * PI
		vector p = player.GetOrigin() + radius * <sin( r ), cos( r ), 0.0>
		bool blocked = false
		foreach ( entity d in live )
		{
			if ( IsValid( d ) && Distance( d.GetOrigin(), p ) < 200.0 )
			{
				blocked = true
				break
			}
		}
		if ( !blocked )
			candidates.append( p )
	}

	if ( candidates.len() == 0 )
	{
		float r = RandomFloat( 1.0 ) * 2.0 * PI
		return player.GetOrigin() + radius * <sin( r ), cos( r ), 0.0>
	}

	return candidates[ RandomInt( candidates.len() ) ]
}

// -----------------------------------------------------------------------------
// Shared freeroam helpers (Floating / Skydiving / Smoothbot)
// -----------------------------------------------------------------------------
entity function AimFreeroam_CreateScriptMover( vector origin, vector angles )
{
	entity script_mover = CreateEntity( "script_mover" )
	script_mover.kv.solid = 0
	script_mover.SetValueForModelKey( $"mdl/dev/empty_model.rmdl" )
	script_mover.kv.SpawnAsPhysicsMover = 0
	script_mover.SetOrigin( origin )
	script_mover.SetAngles( angles )
	DispatchSpawn( script_mover )
	return script_mover
}

void function AimFreeroam_AttachJetTrails( entity npc )
{
	if ( !IsValid( npc ) )
		return

	array<string> attachments = [ "vent_left", "vent_right" ]
	int fxId = GetParticleSystemIndex( $"P_enemy_jump_jet_ON_trails" )
	foreach ( attachment in attachments )
	{
		int att = npc.LookupAttachment( attachment )
		if ( att <= 0 )
			continue
		StartParticleEffectOnEntity_ReturnEntity( npc, fxId, FX_PATTACH_POINT_FOLLOW, att )
	}
}

void function AimFreeroam_StopGroundPlant( entity npc )
{
	if ( !IsValid( npc ) )
		return
	npc.Signal( "StopPushNPCDownToGround" )
	npc.Signal( "JumpPad_DummieInAir" )
}

bool function AimFreeroam_RegisterOwnedDummy( entity player, entity npc )
{
	if ( !IsValid( npc ) )
		return false

	if ( !AimTrainer_RegisterDummy( player, npc ) )
	{
		npc.Destroy()
		return false
	}

	if ( IsValid( player ) )
		AddToUltimateRealm( player, npc )
		npc.SetAimAssistAllowed( true )

	npc.EnableNPCFlag( NPC_IGNORE_ALL | NPC_DISABLE_SENSING | NPC_NO_WEAPON_DROP )
	npc.SetTitle( "" )
	return true
}

// -----------------------------------------------------------------------------
// Floating Target -- immortal dummy in front of player; damage kicks it around
// -----------------------------------------------------------------------------
void function AimFreeroam_FloatingTargetLoop( entity player )
{
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDeath" )
	player.EndSignal( "AimFreeroam_Stop" )

	OnThreadEnd(
		function() : ()
		{
			printt( "[AimFreeroam] Floating Target ended" )
		}
	)

	// Hold spawns until the pre-start description window is over.
	AimTrainer_WaitForIntro( player )

	entity live = null

	while ( IsValid( player ) )
	{
		if ( !IsValid( live ) || !IsAlive( live ) )
		{
			if ( AimTrainer_GetBudgetRemaining() <= 0 )
			{
				WaitFrame()
				continue
			}

			live = AimFreeroam_SpawnFloatingDummy( player )
			if ( !IsValid( live ) )
			{
				wait 0.5
				continue
			}
		}
		else if ( Distance( live.GetOrigin(), player.GetOrigin() ) > AIM_FREEROAM_MAX_DIST )
		{
			// Too far -- session cleanup will despawn; clear so we respawn closer.
			live.Destroy()
			live = null
		}

		WaitFrame()
	}
}

entity function AimFreeroam_SpawnFloatingDummy( entity player )
{
	vector origin = player.GetOrigin() + AnglesToForward( player.GetAngles() ) * AIM_FREEROAM_FLOATING_DIST
	vector angles = <0.0, VectorToAngles( player.GetOrigin() - origin ).y, 0.0>

	// autoPlantGround=false -- velocity kicks must not fight plant SetOrigin.
	entity npc = SpawnNPCTrainingDummy( origin, angles, AimTrainer_ResolveDummyShieldLevel( player ), false, false )
	if ( !IsValid( npc ) )
		return null

	AimFreeroam_StopGroundPlant( npc )
	vector groundPos = GetGroundPosition( origin + <0, 0, 32>, origin + <0, 0, -256>, [ npc ] ).endPos
	if ( !TrySetOriginInWorld( npc, groundPos + <0, 0, 8> ) )
	{
		npc.Destroy()
		return null
	}
	npc.SetAngles( angles )
	Dummy_SetStraferSkin( npc )

	if ( !AimFreeroam_RegisterOwnedDummy( player, npc ) )
		return null

	AimFreeroam_AttachJetTrails( npc )
	AddEntityCallback_OnDamaged( npc, AimFreeroam_OnFloatingDummyDamaged )
	return npc
}

// Immortal + random lateral/forward kick (Flowstate OnFloatingDummyDamaged). Entity-scoped only.
// Pad HP before the hit can kill (same idea as ImmortalDummy_OnDamaged), then refill.
void function AimFreeroam_OnFloatingDummyDamaged( entity dummy, var damageInfo )
{
	if ( !IsValid( dummy ) || !IsAlive( dummy ) )
		return

	entity player = DamageInfo_GetAttacker( damageInfo )
	if ( !IsValid( player ) || !player.IsPlayer() )
		return

	float dmg = DamageInfo_GetDamage( damageInfo )
	if ( dmg <= 0.0 )
		return

	int health = dummy.GetHealth()
	int shield = dummy.GetShieldHealth()
	float bodyDamage = max( 0.0, dmg - float( shield ) )
	if ( bodyDamage >= float( health ) )
		dummy.SetHealth( int( bodyDamage ) + 1 )

	// Full refill so the target never bleeds down over many hits.
	dummy.SetHealth( dummy.GetMaxHealth() )
	if ( dummy.GetShieldHealthMax() > 0 )
		dummy.SetShieldHealth( dummy.GetShieldHealthMax() )

	int side = CoinFlip() ? 1 : -1
	vector vec2 = player.GetOrigin() - dummy.GetOrigin()
	vector angles2 = VectorToAngles( vec2 )

	int random2 = RandomIntRangeInclusive( 1, 5 )
	if ( random2 <= 3 )
		dummy.SetVelocity( ( AnglesToRight( angles2 ) * RandomFloatRange( 128.0, 425.0 ) * float( side ) ) + <0, 0, RandomFloatRange( 250.0, 425.0 ) + dmg * 3.0> )
	else
		dummy.SetVelocity( ( AnglesToForward( angles2 ) * RandomFloatRange( 128.0, 256.0 ) ) + <0, 0, RandomFloatRange( 250.0, 425.0 ) + dmg * 3.0> )
}

// -----------------------------------------------------------------------------
// Skydiving Targets -- high spawn, script_mover dive to ground ring, land = destroy
// -----------------------------------------------------------------------------
void function AimFreeroam_SkydivingLoop( entity player )
{
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDeath" )
	player.EndSignal( "AimFreeroam_Stop" )

	OnThreadEnd(
		function() : ()
		{
			printt( "[AimFreeroam] Skydiving ended" )
		}
	)

	// Hold spawns until the pre-start description window is over.
	AimTrainer_WaitForIntro( player )

	array<entity> live = []

	while ( IsValid( player ) )
	{
		for ( int i = live.len() - 1; i >= 0; i-- )
		{
			if ( !IsValid( live[i] ) || !IsAlive( live[i] ) )
				live.remove( i )
		}

		while ( live.len() < AIM_FREEROAM_SKYDIVING_MAX )
		{
			if ( AimTrainer_GetBudgetRemaining() <= 0 )
				break

			entity npc = AimFreeroam_SpawnSkydivingDummy( player )
			if ( !IsValid( npc ) )
				break

			live.append( npc )
			thread AimFreeroam_SkydivingDive( npc, player, live )
		}

		WaitFrame()
	}
}

entity function AimFreeroam_SpawnSkydivingDummy( entity player )
{
	float r = float( RandomInt( AIM_FREEROAM_SKY_RING_PTS ) ) / float( AIM_FREEROAM_SKY_RING_PTS ) * 2.0 * PI
	vector highPos = player.GetOrigin() + <0, 0, AIM_FREEROAM_SKY_HEIGHT> + AIM_FREEROAM_SKY_HIGH_RADIUS * <sin( r ), cos( r ), 0.0>
	vector angles = <0.0, VectorToAngles( player.GetOrigin() - highPos ).y, 0.0>

	entity npc = SpawnNPCTrainingDummy( highPos, angles, AimTrainer_ResolveDummyShieldLevel( player ), false, false )
	if ( !IsValid( npc ) )
		return null

	AimFreeroam_StopGroundPlant( npc )
	if ( !TrySetOriginInWorld( npc, highPos ) )
	{
		npc.Destroy()
		return null
	}
	npc.SetAngles( angles )
	Dummy_SetStraferSkin( npc )

	if ( !AimFreeroam_RegisterOwnedDummy( player, npc ) )
		return null

	AimFreeroam_AttachJetTrails( npc )
	return npc
}

void function AimFreeroam_SkydivingDive( entity dummy, entity player, array<entity> live )
{
	dummy.EndSignal( "OnDeath" )
	dummy.EndSignal( "OnDestroy" )
	if ( IsValid( player ) )
	{
		player.EndSignal( "OnDestroy" )
		player.EndSignal( "AimFreeroam_Stop" )
	}

	// Build ground targets relative to player at dive start.
	array<vector> groundRing = []
	for ( int i = 0; i < AIM_FREEROAM_SKY_RING_PTS; i++ )
	{
		float r = float( i ) / float( AIM_FREEROAM_SKY_RING_PTS ) * 2.0 * PI
		vector p = player.GetOrigin() + AIM_FREEROAM_SKY_GROUND_RADIUS * <sin( r ), cos( r ), 0.0>
		vector ground = GetGroundPosition( p + <0, 0, 128>, p + <0, 0, -2048>, [] ).endPos
		groundRing.append( ground )
	}

	int locationindex = RandomInt( groundRing.len() )
	vector endPos = groundRing[locationindex]
	vector angles2 = VectorToAngles( endPos - dummy.GetOrigin() )
	dummy.SetAngles( angles2 )

	entity script_mover = AimFreeroam_CreateScriptMover( dummy.GetOrigin(), angles2 )
	dummy.SetParent( script_mover )

	OnThreadEnd(
		function() : ( dummy, script_mover, live )
		{
			if ( IsValid( dummy ) )
				dummy.ClearParent()
			if ( IsValid( script_mover ) )
				script_mover.Destroy()
			live.removebyvalue( dummy )
			// Land path Destroy's the dummy; stop/restart leaves cleanup to session.
		}
	)

	EmitSoundOnEntity( dummy, "Survival_InGameFlight_Travel_3P" )
	script_mover.SetAngles( angles2 )
	script_mover.NonPhysicsMoveTo( endPos, AIM_FREEROAM_SKY_DIVE_TIME, 0.0, 0.0 )
	thread AimFreeroam_PlaySkyDiveAnims( dummy, endPos )

	// Wait until land destroy or death/stop.
	while ( IsValid( dummy ) && IsAlive( dummy ) )
	{
		float heightLeft = dummy.GetOrigin().z - endPos.z
		if ( heightLeft <= 50.0 )
		{
			if ( IsValid( dummy ) )
				dummy.Destroy()
			break
		}
		WaitFrame()
	}
}

// Training dummy model has no freefall activities -- sounds only (no Anim_ScriptedPlay*).
void function AimFreeroam_PlaySkyDiveAnims( entity dummy, vector locationEnd )
{
	dummy.EndSignal( "OnDeath" )
	dummy.EndSignal( "OnDestroy" )

	bool landSoundPlayed = false

	while ( IsValid( dummy ) )
	{
		float distance = dummy.GetOrigin().z - locationEnd.z

		if ( distance <= 750.0 && !landSoundPlayed )
		{
			landSoundPlayed = true
			StopSoundOnEntity( dummy, "Survival_InGameFlight_Travel_3P" )
			EmitSoundOnEntity( dummy, "Survival_InGameFlight_Land_Stop_3P" )
		}

		WaitFrame()
	}
}

// -----------------------------------------------------------------------------
// Smoothbot -- curved motion inside a front box (soft walls + mild steer).
// Hard wall flips = straight lines + sharp corners. Soft fields + steering = curves.
// Subtle speed sine. Overlapping NonPhysicsMoveTo keeps glide clean.
// -----------------------------------------------------------------------------
void function AimFreeroam_SmoothbotLoop( entity player )
{
	player.EndSignal( "OnDestroy" )
	player.EndSignal( "OnDeath" )
	player.EndSignal( "AimFreeroam_Stop" )

	OnThreadEnd(
		function() : ()
		{
			printt( "[AimFreeroam] Smoothbot ended" )
		}
	)

	// Hold spawns until the pre-start description window is over.
	AimTrainer_WaitForIntro( player )

	while ( IsValid( player ) )
	{
		if ( AimTrainer_GetBudgetRemaining() <= 0 )
		{
			wait 0.5
			continue
		}

		entity npc = AimFreeroam_SpawnSmoothbotDummy( player )
		if ( !IsValid( npc ) )
		{
			wait 0.5
			continue
		}

		waitthread AimFreeroam_SmoothbotMovement( npc, player )
		wait 0.5
	}
}

float function AimFreeroam_SmoothbotApproachAngle( float current, float target, float maxDelta )
{
	float d = AngleDiff( target, current )
	if ( d > maxDelta )
		return current + maxDelta
	if ( d < -maxDelta )
		return current - maxDelta
	return current + d
}

// Soft force from one axis when inside the wall margin (smooth turn, not a flip).
float function AimFreeroam_SmoothbotWallPush( float p, float half, float margin, float force )
{
	float inner = half - margin
	if ( inner < 1.0 )
		inner = 1.0

	if ( p > inner )
	{
		float u = ( p - inner ) / margin
		if ( u > 1.0 )
			u = 1.0
		return -force * u * u
	}
	if ( p < -inner )
	{
		float u = ( -p - inner ) / margin
		if ( u > 1.0 )
			u = 1.0
		return force * u * u
	}
	return 0.0
}

// Curved step: soft walls + steer + subtle speed. Returns [pos, vel].
array<vector> function AimFreeroam_SmoothbotStep( vector pos, vector vel, vector steer, float dt, float speed )
{
	// Soft wall accelerations (curve away before the edge).
	vector acc = <
		AimFreeroam_SmoothbotWallPush( pos.x, AIM_FREEROAM_SMOOTH_HALF_RIGHT, AIM_FREEROAM_SMOOTH_WALL_MARGIN, AIM_FREEROAM_SMOOTH_WALL_FORCE ),
		AimFreeroam_SmoothbotWallPush( pos.y, AIM_FREEROAM_SMOOTH_HALF_UP, AIM_FREEROAM_SMOOTH_WALL_MARGIN, AIM_FREEROAM_SMOOTH_WALL_FORCE ),
		AimFreeroam_SmoothbotWallPush( pos.z, AIM_FREEROAM_SMOOTH_HALF_DEPTH, AIM_FREEROAM_SMOOTH_WALL_MARGIN, AIM_FREEROAM_SMOOTH_WALL_FORCE )
	>

	// Mild mid-box steering for organic curves.
	acc = acc + steer * AIM_FREEROAM_SMOOTH_STEER

	vel = vel + acc * dt
	pos = pos + vel * dt

	// Hard clamp only as safety net if soft field is overpowered (rare).
	if ( pos.x > AIM_FREEROAM_SMOOTH_HALF_RIGHT )
		pos = <AIM_FREEROAM_SMOOTH_HALF_RIGHT, pos.y, pos.z>
	else if ( pos.x < -AIM_FREEROAM_SMOOTH_HALF_RIGHT )
		pos = <-AIM_FREEROAM_SMOOTH_HALF_RIGHT, pos.y, pos.z>

	if ( pos.y > AIM_FREEROAM_SMOOTH_HALF_UP )
		pos = <pos.x, AIM_FREEROAM_SMOOTH_HALF_UP, pos.z>
	else if ( pos.y < -AIM_FREEROAM_SMOOTH_HALF_UP )
		pos = <pos.x, -AIM_FREEROAM_SMOOTH_HALF_UP, pos.z>

	if ( pos.z > AIM_FREEROAM_SMOOTH_HALF_DEPTH )
		pos = <pos.x, pos.y, AIM_FREEROAM_SMOOTH_HALF_DEPTH>
	else if ( pos.z < -AIM_FREEROAM_SMOOTH_HALF_DEPTH )
		pos = <pos.x, pos.y, -AIM_FREEROAM_SMOOTH_HALF_DEPTH>

	// Soft renorm toward target speed (keeps subtle speed var; no hard snap).
	float vlen = Length( vel )
	if ( vlen > 0.001 )
	{
		float blend = 4.0 * dt
		if ( blend > 1.0 )
			blend = 1.0
		float newLen = vlen + ( speed - vlen ) * blend
		vel = vel * ( newLen / vlen )
	}
	else
	{
		vel = <speed, 0, 0>
	}

	array<vector> out
	out.append( pos )
	out.append( vel )
	return out
}

vector function AimFreeroam_SmoothbotLocalToWorld( vector eye, float yawDeg, float pitchDeg, vector localPos )
{
	vector fwd = AnglesToForward( <pitchDeg, yawDeg, 0> )
	vector right = AnglesToRight( <0, yawDeg, 0> )
	vector up = <0, 0, 1>
	return eye + fwd * ( AIM_FREEROAM_SMOOTH_CENTER_DEPTH + localPos.z ) + right * localPos.x + up * localPos.y
}

vector function AimFreeroam_SmoothbotRandomSteer()
{
	// Unit-ish random direction for mid-box curve steering.
	float yaw = RandomFloat( 1.0 ) * 2.0 * PI
	float pitch = RandomFloatRange( -0.55, 0.55 )
	return <cos( yaw ) * cos( pitch ), sin( pitch ), sin( yaw ) * cos( pitch )>
}

entity function AimFreeroam_SpawnSmoothbotDummy( entity player )
{
	vector ang = player.EyeAngles()
	vector localPos = <AIM_FREEROAM_SMOOTH_HALF_RIGHT * 0.25, 0, 0>
	vector origin = AimFreeroam_SmoothbotLocalToWorld( player.EyePosition(), ang.y, ang.x, localPos )
	vector angles = <0.0, VectorToAngles( player.GetOrigin() - origin ).y, 0.0>

	entity npc = SpawnNPCTrainingDummy( origin, angles, AimTrainer_ResolveDummyShieldLevel( player ), false, false )
	if ( !IsValid( npc ) )
		return null

	AimFreeroam_StopGroundPlant( npc )
	if ( !TrySetOriginInWorld( npc, origin ) )
	{
		npc.Destroy()
		return null
	}
	npc.SetAngles( angles )
	npc.SetMaxHealth( 5000 )
	npc.SetHealth( 5000 )
	Dummy_SetStraferSkin( npc )

	if ( !AimFreeroam_RegisterOwnedDummy( player, npc ) )
		return null

	AddEntityCallback_OnDamaged( npc, AimFreeroam_SmoothbotOnDamaged )
	return npc
}

void function AimFreeroam_SmoothbotOnDamaged( entity dummy, var damageInfo )
{
	if ( !IsValid( dummy ) || !IsAlive( dummy ) )
		return

	float dmg = DamageInfo_GetDamage( damageInfo )
	if ( dmg <= 0.0 )
		return

	int maxHp = dummy.GetMaxHealth()
	if ( maxHp < 1 )
		return

	dummy.SetHealth( maxHp )
	int shieldMax = dummy.GetShieldHealthMax()
	if ( shieldMax > 0 )
		dummy.SetShieldHealth( shieldMax )

	int health = dummy.GetHealth()
	int shield = dummy.GetShieldHealth()
	float pool = float( health + shield )
	if ( pool > 1.0 && dmg >= pool )
		DamageInfo_SetDamage( damageInfo, pool - 1.0 )
}

void function AimFreeroam_SmoothbotMovement( entity dummy, entity player )
{
	dummy.EndSignal( "OnDeath" )
	dummy.EndSignal( "OnDestroy" )
	if ( IsValid( player ) )
	{
		player.EndSignal( "OnDestroy" )
		player.EndSignal( "AimFreeroam_Stop" )
	}

	entity script_mover = AimFreeroam_CreateScriptMover( dummy.GetOrigin(), dummy.GetAngles() )
	dummy.SetParent( script_mover )

	OnThreadEnd(
		function() : ( dummy, script_mover )
		{
			if ( IsValid( dummy ) )
				dummy.ClearParent()
			if ( IsValid( script_mover ) )
				script_mover.Destroy()
		}
	)

	vector softEye = player.EyePosition()
	vector eyeAng = player.EyeAngles()
	float softYaw = eyeAng.y
	float softPitch = eyeAng.x

	// Local box state -- start offset, mostly horizontal launch.
	vector localPos = <AIM_FREEROAM_SMOOTH_HALF_RIGHT * 0.25, 0, 0>
	float yaw0 = RandomFloat( 1.0 ) * 2.0 * PI
	float pitch0 = RandomFloatRange( -0.25, 0.25 )
	vector localVel = <cos( yaw0 ) * cos( pitch0 ), sin( pitch0 ), sin( yaw0 ) * cos( pitch0 )> * AIM_FREEROAM_SMOOTH_SPEED

	vector steer = AimFreeroam_SmoothbotRandomSteer()
	float nextSteer = Time() + AIM_FREEROAM_SMOOTH_STEER_RETARGET
	float t0 = Time()

	vector start = AimFreeroam_SmoothbotLocalToWorld( softEye, softYaw, softPitch, localPos )
	script_mover.NonPhysicsMoveTo( start, AIM_FREEROAM_SMOOTH_BLEND, 0.0, 0.0 )
	wait AIM_FREEROAM_SMOOTH_REISSUE

	while ( IsValid( dummy ) && IsValid( player ) && IsValid( script_mover ) )
	{
		dummy.Anim_Stop()

		vector wantEye = player.EyePosition()
		vector wantAng = player.EyeAngles()
		softEye = softEye + ( wantEye - softEye ) * AIM_FREEROAM_SMOOTH_VIEW_FOLLOW
		softYaw = AimFreeroam_SmoothbotApproachAngle( softYaw, wantAng.y, 8.0 )
		softPitch = softPitch + ( wantAng.x - softPitch ) * AIM_FREEROAM_SMOOTH_VIEW_FOLLOW

		// Slow steer retarget (organic mid-box curves, not frantic).
		if ( Time() >= nextSteer )
		{
			steer = AimFreeroam_SmoothbotRandomSteer()
			nextSteer = Time() + RandomFloatRange( AIM_FREEROAM_SMOOTH_STEER_RETARGET * 0.7, AIM_FREEROAM_SMOOTH_STEER_RETARGET * 1.4 )
		}

		// Subtle speed variation (smooth sine -- not random spikes).
		float t = Time() - t0
		float speedNow = AIM_FREEROAM_SMOOTH_SPEED * ( 1.0 + AIM_FREEROAM_SMOOTH_SPEED_VAR * sin( AIM_FREEROAM_SMOOTH_SPEED_FREQ * t ) )

		float stepDt = AIM_FREEROAM_SMOOTH_REISSUE / float( AIM_FREEROAM_SMOOTH_PHYS_STEPS )
		for ( int i = 0; i < AIM_FREEROAM_SMOOTH_PHYS_STEPS; i++ )
		{
			array<vector> stepped = AimFreeroam_SmoothbotStep( localPos, localVel, steer, stepDt, speedNow )
			localPos = stepped[0]
			localVel = stepped[1]
		}

		// Look-ahead for overlapping mover blend.
		vector aheadPos = localPos
		vector aheadVel = localVel
		float aheadDt = AIM_FREEROAM_SMOOTH_BLEND / float( AIM_FREEROAM_SMOOTH_PHYS_STEPS )
		for ( int j = 0; j < AIM_FREEROAM_SMOOTH_PHYS_STEPS; j++ )
		{
			array<vector> stepped2 = AimFreeroam_SmoothbotStep( aheadPos, aheadVel, steer, aheadDt, speedNow )
			aheadPos = stepped2[0]
			aheadVel = stepped2[1]
		}

		vector target = AimFreeroam_SmoothbotLocalToWorld( softEye, softYaw, softPitch, aheadPos )
		vector face = VectorToAngles( player.GetOrigin() - target )
		script_mover.SetAngles( <0, face.y, 0> )
		script_mover.NonPhysicsMoveTo( target, AIM_FREEROAM_SMOOTH_BLEND, 0.0, 0.0 )

		wait AIM_FREEROAM_SMOOTH_REISSUE
	}
}

void function SetAISettingsWrapper( entity npc, string settings )
{
	npc.SetAISettings( settings )

	// This assert was added at some point to enforce designers naming things correctly so people can easily see
	// the parent npc it was derived from, if any (example: npc_soldier_lmg is derived from the base npc_soldier)
	//Assert( settings.find( npc.GetClassName() ) == 0, settings + " settings file needs the string " + npc.GetClassName() + " added to the actual npc name string as a prefix." )
}

