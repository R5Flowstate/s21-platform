// Waiting-room fill lights. colorIdx: 0 white, 1 warm. lightId is a stable slot.
void function ServerCallback_SpawnOrModifyClientSideDynamicLight( vector origin, vector angles, int colorIdx, int radius, float intensity, int lightId )
{
	vector color = <1.0, 1.0, 1.0>
	if ( colorIdx == 1 )
		color = <1.0, 0.85, 0.55>

	float brightness = intensity
	if ( brightness <= 0.0 )
		brightness = 1.0

	entity light = null
	if ( lightId in file.clientDynamicLights )
	{
		light = file.clientDynamicLights[ lightId ]
		if ( !IsValid( light ) )
			light = null
	}

	if ( light == null )
	{
		light = CreateClientSideDynamicLight( origin, angles, color * brightness, 0.0 )
		file.clientDynamicLights[ lightId ] <- light
	}
	else
	{
		light.SetOrigin( origin )
		light.SetAngles( angles )
		light.SetLightColor( color * brightness )
	}

	if ( IsValid( light ) )
		light.SetLightRadius( float( radius ) )
}

const array<asset> FS_1V1_WORLD_BANNER_IMAGES = [
	$"rui/world/flowstate1v1_banner01",
	$"rui/world/flowstate1v1_banner03",
	$"rui/world/flowstate1v1_banner04",
]
const float FS_1V1_WORLD_BANNER_ALPHA = 0.95
const float FS_1V1_WORLD_BANNER_CYCLE = 10.0
const float FS_1V1_WORLD_BANNER_FADE = 2.0

void function FS_1v1_WorldBanner_Destroy()
{
	if ( IsValid( clGlobal.levelEnt ) )
		clGlobal.levelEnt.Signal( "FS_1v1_WorldBannerStop" )

	if ( file.worldBannerRui != null )
	{
		RuiDestroyIfAlive( file.worldBannerRui )
		file.worldBannerRui = null
	}
	if ( file.worldBannerTopo != null )
	{
		RuiTopology_Destroy( file.worldBannerTopo )
		file.worldBannerTopo = null
	}
}

void function FS_1v1_WorldBanner_SetTint( float t )
{
	if ( file.worldBannerRui == null )
		return
	RuiSetFloat3( file.worldBannerRui, "basicImageColor", <t, t, t> )
}

void function FS_1v1_WorldBanner_Fade( float from, float to, float dur )
{
	float start = Time()
	while ( true )
	{
		if ( file.worldBannerRui == null )
			return
		float u = dur > 0.0 ? ( Time() - start ) / dur : 1.0
		if ( u >= 1.0 )
			break
		FS_1v1_WorldBanner_SetTint( from + ( to - from ) * u )
		WaitFrame()
	}
	FS_1v1_WorldBanner_SetTint( to )
}

void function FS_1v1_WorldBanner_Apply( asset img )
{
	if ( file.worldBannerRui == null )
		return
	RuiSetImage( file.worldBannerRui, "basicImage", img )
	FS_1v1_WorldBanner_SetTint( FS_1V1_WORLD_BANNER_ALPHA )
}

void function FS_1v1_WorldBanner_CycleTHREAD()
{
	if ( IsValid( clGlobal.levelEnt ) )
		clGlobal.levelEnt.EndSignal( "FS_1v1_WorldBannerStop" )

	entity player = GetLocalClientPlayer()
	if ( IsValid( player ) )
		player.EndSignal( "OnDestroy" )

	int count = FS_1V1_WORLD_BANNER_IMAGES.len()
	if ( count < 2 )
		return

	int idx = 0
	while ( true )
	{
		wait FS_1V1_WORLD_BANNER_CYCLE
		if ( file.worldBannerRui == null )
			return

		FS_1v1_WorldBanner_Fade( FS_1V1_WORLD_BANNER_ALPHA, 0.0, FS_1V1_WORLD_BANNER_FADE )
		if ( file.worldBannerRui == null )
			return

		idx = ( idx + 1 ) % count
		FS_1v1_WorldBanner_Apply( FS_1V1_WORLD_BANNER_IMAGES[ idx ] )
		FS_1v1_WorldBanner_Fade( 0.0, FS_1V1_WORLD_BANNER_ALPHA, FS_1V1_WORLD_BANNER_FADE )
	}
}

void function ServerCallback_FS_1v1_WorldBanner( vector origin, vector angles, float width, float height )
{
	FS_1v1_WorldBanner_Destroy()

	if ( width < 1.0 || height < 1.0 )
		return

	file.worldBannerTopo = CreateRUITopology_Worldspace( origin, angles, width, height )
	file.worldBannerRui = RuiCreate( $"ui/basic_image.rpak", file.worldBannerTopo, RUI_DRAW_WORLD, 0 )
	FS_1v1_WorldBanner_Apply( FS_1V1_WORLD_BANNER_IMAGES[ 0 ] )
	printt( "[FS-Banner] world banner rui at " + string( origin ) + " cycle=" + string( FS_1V1_WORLD_BANNER_IMAGES.len() ) )
	thread FS_1v1_WorldBanner_CycleTHREAD()
}
#endif // CLIENT

#if SERVER
const float FS_1V1_PODIUM_EMOTE_RATE = 2.0
// The t-bag is one pulse per crouch press, so the floor sits just under the
// client's send throttle -- tight enough to bound a spoofed client, loose enough
// that an honest one is never dropped on jitter.
const float FS_1V1_PODIUM_TBAG_RATE = 0.15

// Both podium performances are driven by one client but replayed on every other
// client, so the sender must be the champion the podium is actually showing, and
// only while that screen is up.
bool function FS_1v1_PodiumPerform_ServerAllows( entity player, string rateKey, float rate )
{
	if ( !GetChampionShowingState() )
		return false
	if ( player.GetEncodedEHandle() != GetGlobalNetInt( "championEEH" ) )
		return false
	return CheckRate( player, rateKey, rate, false )
}

void function ClientCallback_FS_1v1_PodiumEmote( entity player, int emoteGUID )
{
	if ( !IsValid( player ) )
		return
	if ( !IsValidItemFlavorGUID( emoteGUID ) )
		return
	if ( ItemFlavor_GetType( GetItemFlavorByGUID( emoteGUID ) ) != eItemType.character_emote )
		return
	if ( !FS_1v1_PodiumPerform_ServerAllows( player, "podium_emote", FS_1V1_PODIUM_EMOTE_RATE ) )
		return

	foreach ( entity other in GetPlayerArray() )
	{
		if ( !IsValid( other ) || other == player || !FS_1v1_PlayerHasClient( other ) )
			continue
		Remote_CallFunction_NonReplay( other, "ServerCallback_FS_1v1_PodiumEmote", emoteGUID )
	}
}

void function ClientCallback_FS_1v1_PodiumTbag( entity player )
{
	if ( !IsValid( player ) )
		return
	if ( !FS_1v1_PodiumPerform_ServerAllows( player, "podium_tbag", FS_1V1_PODIUM_TBAG_RATE ) )
		return

	foreach ( entity other in GetPlayerArray() )
	{
		if ( !IsValid( other ) || other == player || !FS_1v1_PlayerHasClient( other ) )
			continue
		Remote_CallFunction_NonReplay( other, "ServerCallback_FS_1v1_PodiumTbag" )
	}
}
#endif // SERVER
