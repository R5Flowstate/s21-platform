void function FS_1v1_CoolCamera_THREAD()
{
	entity player = GetLocalClientPlayer()
	if ( !IsValid( player ) )
		return

	if ( file.coolCameraRunning )
	{
		Signal( player, "ChallengeStartRemoveCameras" )
		WaitFrame()
		player = GetLocalClientPlayer()
		if ( !IsValid( player ) )
			return
	}

	array<LocPair> cutsceneSpawns = FS_1v1_GetCoolCameraSpawns()
	if ( cutsceneSpawns.len() == 0 )
		return

	file.coolCameraRunning = true
	FS_1v1_ChampionHudHide( player )
	EndSignal( player, "ChallengeStartRemoveCameras" )
	EndSignal( player, "OnDestroy" )

	cutsceneSpawns.randomize()
	vector randomcameraPos = cutsceneSpawns[0].origin
	vector randomcameraAng = cutsceneSpawns[0].angles

	entity camera = CreateClientSidePointCamera( randomcameraPos, randomcameraAng, 17 )
	camera.SetFOV( 100 )
	entity cutsceneMover = CreateClientsideScriptMover( $"mdl/dev/empty_model.rmdl", randomcameraPos, randomcameraAng )
	camera.SetParent( cutsceneMover )
	player.SetMenuCameraEntity( camera )
	DoF_SetFarDepth( 6000, 10000 )

	OnThreadEnd(
		function() : ( player, cutsceneMover, camera )
		{
			file.coolCameraRunning = false
			if ( IsValid( player ) )
			{
				player.ClearMenuCameraEntity()
				int st = player.GetPlayerNetInt( "FS_1v1_PlayerState" )
				if ( FS_1v1_ShouldShowCombatHud( st ) )
					FS_1v1_ChampionHudShow( player )
			}
			if ( IsValid( camera ) )
				camera.Destroy()
			if ( IsValid( cutsceneMover ) )
				cutsceneMover.Destroy()
			DoF_SetNearDepthToDefault()
			DoF_SetFarDepthToDefault()
		}
	)

	printt( "[FS-1V1] CoolCamera start map=" + GetMapName() + " shots=" + string( cutsceneSpawns.len() ) )
	FS_1v1_CoolCameraMovement( player, cutsceneMover, camera, cutsceneSpawns )
}

void function FS_1v1_CoolCameraMovement( entity player, entity cutsceneMover, entity camera, array<LocPair> cutsceneSpawns )
{
	int locationindex = 0

	while ( true )
	{
		if ( locationindex == cutsceneSpawns.len() )
			locationindex = 0

		vector startpos = cutsceneSpawns[locationindex].origin
		vector startangs = cutsceneSpawns[locationindex].angles
		locationindex++

		cutsceneMover.SetOrigin( startpos )
		cutsceneMover.SetAngles( startangs )
		camera.SetOrigin( startpos )
		camera.SetAngles( startangs )

		cutsceneMover.NonPhysicsMoveTo( startpos + AnglesToRight( startangs ) * 700, 15, 0, 0 )
		cutsceneMover.NonPhysicsRotateTo( startangs, 10, 0.0, 3.0 )
		wait 5
	}
}

