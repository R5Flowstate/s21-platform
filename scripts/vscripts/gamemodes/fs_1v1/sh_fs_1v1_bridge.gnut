// Flowstate Message(player, title, sub, duration, sound) -- freeform banner.
void function Message( entity player, string text, string subText = "", float duration = 7.0, string sound = "" )
{
	if ( !IsValid( player ) )
		return
	#if SERVER
		if ( subText != "" )
			LocalSplashMsg( player, text + "\n" + subText, duration )
		else
			LocalSplashMsg( player, text, duration )
		if ( sound != "" )
			thread EmitSoundOnEntityOnlyToPlayer( player, player, sound )
	#endif
}

// Flowstate freeform single-line banner.
void function Message_New( entity player, string msg, float duration = 5.0 )
{
	if ( !IsValid( player ) )
		return
	#if SERVER
		LocalSplashMsg( player, msg, duration )
	#endif
}

// Playlist weapon-list join: str2 is a continuation field (prepended with comma).
string function Concatenate( string str1, string str2 )
{
	if ( str1 == "" && str2 == "" )
		return ""

	if ( str2 != "" )
		str2 = "," + str2

	return str1 + str2
}

// Tracker used a weapon-id table; S21 validates via survival loot refs.
bool function IsWeaponValid( string weaponref )
{
	return SURVIVAL_Loot_IsRefValid( weaponref )
}

bool function IsModValidForWeapon( string weaponref, string mod )
{
	array<string> attachPoint = GetAttachPointsForAttachment( mod )
	if ( attachPoint.len() < 1 )
		return false

	LootData wData = SURVIVAL_Loot_GetLootDataByRef( weaponref )
	return ( wData.supportedAttachments.contains( attachPoint[ 0 ] )
		&& !wData.disabledAttachments.contains( attachPoint[ 0 ] ) )
}

void function PrintSupportedAttachpointsForWeapon( string weaponref )
{
	if ( !SURVIVAL_Loot_IsRefValid( weaponref ) )
		return

	LootData wData = SURVIVAL_Loot_GetLootDataByRef( weaponref )
	string debug = format( "\n --- Attachment List for %s --- \n", weaponref )
	int i = 1
	foreach ( supported in wData.supportedAttachments )
	{
		debug += format( "%d. %s \n", i, supported )
		i++
	}
	sqprint( debug )
}

void function SavePlayerData( entity player, string key, var value )
{
	if ( !IsValid( player ) )
		return
	#if SERVER
		if ( key == "wait_time" )
		{
			player.p.IBMM_grace_period = expect float( value )
			FS_1v1_RefreshQueueGrace( player )
		}
		else if ( key == "saved_weapons" )
		{
			player.p.weapon_loadout = expect string( value )
		}
		else
		{
			printt( "[FS-1V1] SavePlayerData unknown key " + player.GetPlayerName() + " " + key )
			return
		}
		FS1v1_Stats_MarkDirty( player )
	#else
		printt( "[FS-1V1] SavePlayerData stub " + player.GetPlayerName() + " " + key + "=" + string( value ) )
	#endif // SERVER
}

#if SERVER
const float FS1V1_STATS_DEBOUNCE = 2.0

table<entity, bool> statsDirty
table<entity, bool> statsFlushRunning
table<entity, bool> statsLoading
table<entity, bool> statsPublishQueued

bool function FS1v1_Stats_IsIntString( string s )
{
	if ( s.len() < 1 )
		return false

	int start = 0
	if ( s.slice( 0, 1 ) == "-" )
	{
		if ( s.len() < 2 )
			return false
		start = 1
	}

	for ( int i = start; i < s.len(); i++ )
	{
		string ch = s.slice( i, i + 1 )
		if ( ( ch < "0" ) || ( ch > "9" ) )
			return false
	}
	return true
}

bool function FS1v1_Stats_IsFloatString( string s )
{
	if ( s.len() < 1 )
		return false

	int start = 0
	if ( s.slice( 0, 1 ) == "-" )
	{
		if ( s.len() < 2 )
			return false
		start = 1
	}

	bool sawDot = false
	bool sawDigit = false
	for ( int i = start; i < s.len(); i++ )
	{
		string ch = s.slice( i, i + 1 )
		if ( ch == "." )
		{
			if ( sawDot )
				return false
			sawDot = true
			continue
		}
		if ( ( ch < "0" ) || ( ch > "9" ) )
			return false
		sawDigit = true
	}
	return sawDigit
}

string function FS1v1_Stats_SanitizeValue( string s )
{
	string out = ""
	for ( int i = 0; i < s.len(); i++ )
	{
		if ( out.len() >= 256 )
			break
		string ch = s.slice( i, i + 1 )
		if ( ch == "\n" || ch == "\r" )
			continue
		out += ch
	}
	return out
}

// Build totals at write time only -- never fold session netvars into the baseline in RAM.
string function FS1v1_Stats_Build( entity player )
{
	string out = "v=1\n"
	out += "# name=" + FS1v1_Stats_SanitizeValue( player.GetPlayerName() ) + "\n"

	int totalKills = player.p.season_kills + player.GetPlayerNetInt( "kills" )
	int totalDeaths = player.p.season_deaths + player.GetPlayerNetInt( "deaths" )
	int careerBest = player.p.careerBestStreak
	if ( player.p.bestStreak > careerBest )
		careerBest = player.p.bestStreak

	out += "i.season_kills=" + string( totalKills ) + "\n"
	out += "i.season_deaths=" + string( totalDeaths ) + "\n"
	out += "i.career_best_streak=" + string( careerBest ) + "\n"
	out += "f.wait_time=" + string( player.p.IBMM_grace_period ) + "\n"

	float hgTime = player.p.headglitchTime + HeadGlitch_GetTotalTime( player )
	int hgEpisodes = player.p.headglitchEpisodes + HeadGlitch_GetEpisodeCount( player )
	int hgFlags = player.p.headglitchFlags + HeadGlitch_GetFlagCount( player )

	float hgPeak = player.p.headglitchPeak
	float sessionPeak = HeadGlitch_GetPeakScore( player )
	if ( sessionPeak > hgPeak )
		hgPeak = sessionPeak

	out += "f.headglitch_time=" + string( hgTime ) + "\n"
	out += "f.headglitch_peak=" + string( hgPeak ) + "\n"
	out += "i.headglitch_episodes=" + string( hgEpisodes ) + "\n"
	out += "i.headglitch_flags=" + string( hgFlags ) + "\n"

	string weapons = FS1v1_Stats_SanitizeValue( player.p.weapon_loadout )
	out += "s.saved_weapons=" + weapons + "\n"

	return out
}

void function FS1v1_Stats_Flush( entity player )
{
	if ( !IsValid( player ) || !player.IsPlayer() || player.IsBot() )
		return

	string payload = FS1v1_Stats_Build( player )
	player.Cafe_PlayerPrefs_Write( "1v1_stats", payload )
}

void function FS1v1_Stats_FlushThread( entity player )
{
	player.EndSignal( "OnDestroy" )

	while ( ( player in statsDirty ) && statsDirty[ player ] )
	{
		statsDirty[ player ] = false
		wait( FS1V1_STATS_DEBOUNCE )
		FS1v1_Stats_Flush( player )
	}

	statsFlushRunning[ player ] <- false
}

void function FS1v1_Stats_MarkDirty( entity player )
{
	if ( !IsValid( player ) || !player.IsPlayer() || player.IsBot() )
		return

	if ( ( player in statsLoading ) && statsLoading[ player ] )
		return

	statsDirty[ player ] <- true

	if ( !( player in statsFlushRunning ) || !statsFlushRunning[ player ] )
	{
		statsFlushRunning[ player ] <- true
		thread FS1v1_Stats_FlushThread( player )
	}

	FS_1v1_PublishCareerStats( player )
	FS_1v1_PublishCareerStatsSoon( player )
}

void function FS1v1_Stats_Load( entity player )
{
	if ( !IsValid( player ) || !player.IsPlayer() )
		return

	// Fake clients have no prefs store, so this is a disk hit for a player whose
	// stats are never persisted.
	if ( player.IsBot() )
		return

	statsLoading[ player ] <- true

	string payload = player.Cafe_PlayerPrefs_Read( "1v1_stats" )
	if ( payload == "" || payload.len() > 4096 )
	{
		statsLoading[ player ] = false
		FS_1v1_PublishCareerStats( player )
		return
	}

	array<string> lines = split( payload, "\n" )
	bool sawVersion = false
	int lineCount = 0

	foreach ( string rawLine in lines )
	{
		if ( lineCount >= 64 )
			break
		lineCount++

		string line = strip( rawLine )
		if ( line.len() > 0 && line.slice( line.len() - 1, line.len() ) == "\r" )
			line = line.slice( 0, line.len() - 1 )
		line = strip( line )

		if ( line.len() < 1 )
			continue

		if ( !sawVersion )
		{
			if ( line != "v=1" )
			{
				statsLoading[ player ] = false
				FS_1v1_PublishCareerStats( player )
				return
			}
			sawVersion = true
			continue
		}

		if ( line.slice( 0, 1 ) == "#" )
			continue

		int eq = line.find( "=" )
		if ( eq < 0 )
			continue

		string key = line.slice( 0, eq )
		string valStr = line.slice( eq + 1, line.len() )

		if ( key.len() < 3 )
			continue

		string prefix = key.slice( 0, 2 )
		string name = key.slice( 2, key.len() )

		if ( prefix == "i." )
		{
			if ( !FS1v1_Stats_IsIntString( valStr ) )
				continue
			int value = valStr.tointeger()
			if ( name == "season_kills" )
				player.p.season_kills = value
			else if ( name == "season_deaths" )
				player.p.season_deaths = value
			else if ( name == "career_best_streak" )
				player.p.careerBestStreak = value
			else if ( name == "headglitch_episodes" && value >= 0 )
				player.p.headglitchEpisodes = value
			else if ( name == "headglitch_flags" && value >= 0 )
				player.p.headglitchFlags = value
		}
		else if ( prefix == "f." )
		{
			if ( !FS1v1_Stats_IsFloatString( valStr ) )
				continue
			float value = valStr.tofloat()
			if ( name == "wait_time" && value >= 0 )
				player.p.IBMM_grace_period = value
			else if ( name == "headglitch_time" && value >= 0 )
				player.p.headglitchTime = value
			else if ( name == "headglitch_peak" && value >= 0 )
				player.p.headglitchPeak = value
		}
		else if ( prefix == "s." )
		{
			if ( name == "saved_weapons" )
			{
				if ( valStr == "" || valStr == "NA" )
					continue
				if ( valStr.len() > 256 )
					valStr = valStr.slice( 0, 256 )
				player.p.weapon_loadout = valStr
				weaponlist_1v1[ player.p.handle ] <- valStr
			}
		}
	}

	statsLoading[ player ] = false
	FS_1v1_PublishCareerStats( player )
}

void function FS_1v1_PublishCareerStats( entity player )
{
	if ( !IsValid( player ) || !player.IsPlayer() )
		return

	int kills = player.p.season_kills + player.GetPlayerNetInt( "kills" )
	int deaths = player.p.season_deaths + player.GetPlayerNetInt( "deaths" )
	if ( kills < 0 )
		kills = 0
	if ( deaths < 0 )
		deaths = 0

	player.SetPlayerNetInt( "FS_1v1_CareerKills", kills )
	player.SetPlayerNetInt( "FS_1v1_CareerDeaths", deaths )
}

void function FS_1v1_PublishCareerStatsSoon( entity player )
{
	if ( !IsValid( player ) || !player.IsPlayer() )
		return
	if ( ( player in statsPublishQueued ) && statsPublishQueued[ player ] )
		return

	statsPublishQueued[ player ] <- true
	thread FS_1v1_PublishCareerStatsSoon_Thread( player )
}

void function FS_1v1_PublishCareerStatsSoon_Thread( entity player )
{
	player.EndSignal( "OnDestroy" )
	OnThreadEnd( void function() : ( player ) {
		if ( player in statsPublishQueued )
			delete statsPublishQueued[ player ]
	} )
	WaitFrame()
	if ( !IsValid( player ) )
		return
	FS_1v1_PublishCareerStats( player )
}

void function FS1v1_Stats_Cleanup( entity player )
{
	if ( IsValid( player ) )
	{
		if ( ( player in statsDirty ) && statsDirty[ player ] )
			FS1v1_Stats_Flush( player )
	}

	if ( player in statsDirty )
		delete statsDirty[ player ]
	if ( player in statsFlushRunning )
		delete statsFlushRunning[ player ]
	if ( player in statsLoading )
		delete statsLoading[ player ]
	if ( player in statsPublishQueued )
		delete statsPublishQueued[ player ]
}
#endif // SERVER

// "mp_weapon_r97 optic_x mag_y" -> validated weapon+mods string, or "".
string function ParseWeapon( string weaponString )
{
	array<string> mods = split( strip( weaponString ), " " )

	if ( mods.len() < 1 )
		return ""

	if ( !IsWeaponValid( mods[ 0 ] ) || !SURVIVAL_Loot_IsRefValid( mods[ 0 ] ) )
		return ""

	bool removed = false
	for ( int i = mods.len() - 1; i >= 1; i-- )
	{
		if ( !SURVIVAL_Loot_IsRefValid( mods[ i ] ) || !IsModValidForWeapon( mods[ 0 ], mods[ i ] ) )
		{
			removed = true
			sqprint( "removed: " + mods[ i ] )
			mods.remove( i )
		}
	}

	if ( removed )
		PrintSupportedAttachpointsForWeapon( mods[ 0 ] )

	return mods.join( " " )
}

void function print_string_array( array<string> args )
{
	string test = "\n\n------ PRINT STRING ARRAY ------\n\n"
	foreach ( arg in args )
		test += format( "\t\"%s\", \n", arg )
	sqprint( test )
}

// Returns false when rate-limited. rateLimitTable is ServerPlayerStruct-only.
bool function CheckRate( entity player, string key = DEFAULT_RATE_KEY, float rate = COMMAND_RATE_LIMIT, bool notify = NOTIFY_RATELIMIT_FAILED )
{
	if ( !IsValid( player ) )
		return false

	#if SERVER
		if ( !( key in player.p.rateLimitTable ) )
			player.p.rateLimitTable[ key ] <- 0.0

		if ( Time() - player.p.rateLimitTable[ key ] <= rate )
		{
			if ( notify )
				LocalEventMsg( player, "#FS_CMD", "", 2.0 )
			return false
		}

		player.p.rateLimitTable[ key ] = Time()
	#endif
	return true
}

void function ResetRate( entity player, string key = DEFAULT_RATE_KEY )
{
	if ( !IsValid( player ) )
		return
	#if SERVER
		if ( !( key in player.p.rateLimitTable ) )
			player.p.rateLimitTable[ key ] <- 0.0
		else
			player.p.rateLimitTable[ key ] = 0.0
	#endif
}

#if SERVER
// Rest-room / challenge world buttons (firing-range access panel model).
entity function CreateFRButton( vector pos, vector ang, string prompt )
{
	entity button = CreateEntity( "prop_dynamic" )
	button.kv.solid = 6
	button.SetValueForModelKey( $"mdl/props/global_access_panel_button/global_access_panel_button_console_w_stand.rmdl" )
	button.SetOrigin( pos )
	button.SetAngles( ang )
	DispatchSpawn( button )
	button.SetUsable()
	button.SetUsableByGroup( "pilot" )
	button.SetUsePrompts( prompt, prompt )
	return button
}

// Challenge / admin name-or-UID lookup (Flowstate GetPlayer).
entity function GetPlayerEntityByUID( string str )
{
	entity candidate = null
	if ( str == "" )
		return candidate

	// Platform UIDs are numeric strings.
	if ( !IsStringNumeric( str ) )
		return candidate

	foreach ( player in GetPlayerArray() )
	{
		if ( !IsValid( player ) )
			continue
		if ( player.GetPlatformUID() == str )
			return player
	}
	return candidate
}

entity function GetPlayer( string str )
{
	entity candidate = GetPlayerEntityByUID( str )
	if ( IsValid( candidate ) )
		return candidate
	return GetPlayerEntityByName( str )
}
#endif

void function sqerror( string msg )
{
	printt( "[FS-SQERROR] " + msg )
}

void function sqwarning( string msg )
{
	printt( "[FS-SQWARN] " + msg )
}

void function sqprint( string msg )
{
	printt( "[FS] " + msg )
}

entity function GetBestPlayer()
{
	#if SERVER
		entity best = null
		int bestKills = -1
		int bestDamage = -1
		bool bestIsBot = true
		foreach ( player in GetPlayerArray() )
		{
			if ( !IsValid( player ) )
				continue

			int k = player.GetPlayerNetInt( "kills" )
			int d = player.GetPlayerNetInt( "damage" )
			bool isBot = player.IsBot()

			bool better = false
			if ( best == null )
				better = true
			else if ( k > bestKills )
				better = true
			else if ( k == bestKills && d > bestDamage )
				better = true
			else if ( k == bestKills && d == bestDamage && bestIsBot && !isBot )
				better = true

			if ( !better )
				continue

			best = player
			bestKills = k
			bestDamage = d
			bestIsBot = isBot
		}
		return best
	#else
		return null
	#endif
}

void function WaitForChampionToFinish()
{
	#if SERVER || CLIENT
		while ( Time() < GetGlobalNetTime( "championDisplayEndTime" ) )
			WaitFrame()
	#else
		wait 0.1
	#endif
}

