void function SendScoreboardToClient()
{
	// Remote_CallFunction_NonReplay is SERVER-only
	#if SERVER
		foreach ( entity sPlayer in GetPlayerArray() )
		{
			if ( !IsValid( sPlayer ) )
				continue
			Remote_CallFunction_NonReplay( sPlayer, "ServerCallback_ClearScoreboardOnClient" )
		}
	#endif
}

#if SERVER
const string FS_1V1_LOBBY_WALL_SCRIPTNAME = "fs_1v1_lobby_wall"
const int FS_1V1_BARRIER_BOX_COLS = 2
const int FS_1V1_BARRIER_BOX_ROWS = 3

void function FS_1v1_SpawnArenaBarrierBox( vector origin )
{
	asset model = FS_1v1_GetArenaBarrierModel()
	float thick = 16.0
	float length = 552.0
	float panelH = 316.0
	bool thinIsX = true

	entity probe = FS_1v1_CreateBarrierBrush( model, origin + <0, 0, -4096>, <0, 0, 0> )
	if ( IsValid( probe ) )
	{
		vector mins = probe.GetBoundingMins()
		vector maxs = probe.GetBoundingMaxs()
		float sx = maxs.x - mins.x
		float sy = maxs.y - mins.y
		float sz = maxs.z - mins.z
		if ( sx > 4.0 && sy > 4.0 && sz > 4.0 && sx < 4096.0 && sy < 4096.0 )
		{
			thinIsX = ( sx <= sy )
			thick = thinIsX ? sx : sy
			length = thinIsX ? sy : sx
			panelH = sz
		}
		probe.Destroy()
	}

	float span = FS_1V1_BARRIER_BOX_COLS.tofloat() * length
	float halfInner = span * 0.5
	float sideOff = halfInner + thick * 0.5
	vector wallYaw = thinIsX ? <0, 0, 0> : <0, 90, 0>
	vector sideYaw = thinIsX ? <0, 90, 0> : <0, 0, 0>
	vector slabAng = thinIsX ? <90, 0, 0> : <0, 0, 90>
	float stepX = thinIsX ? panelH : length
	float stepY = thinIsX ? length : panelH

	int n = 0
	int row
	int col
	for ( row = 0; row < FS_1V1_BARRIER_BOX_ROWS; row++ )
	{
		float z = origin.z + panelH * 0.5 + row.tofloat() * panelH
		for ( col = 0; col < FS_1V1_BARRIER_BOX_COLS; col++ )
		{
			float along = -halfInner + length * 0.5 + col.tofloat() * length
			if ( FS_1v1_SpawnBarrierPanel( model, <origin.x + sideOff, origin.y + along, z>, wallYaw ) )
				n++
			if ( FS_1v1_SpawnBarrierPanel( model, <origin.x - sideOff, origin.y + along, z>, wallYaw ) )
				n++
			if ( FS_1v1_SpawnBarrierPanel( model, <origin.x + along, origin.y + sideOff, z>, sideYaw ) )
				n++
			if ( FS_1v1_SpawnBarrierPanel( model, <origin.x + along, origin.y - sideOff, z>, sideYaw ) )
				n++
		}
	}

	float zFloor = origin.z - thick * 0.5
	float zCeil = origin.z + FS_1V1_BARRIER_BOX_ROWS.tofloat() * panelH + thick * 0.5
	n += FS_1v1_SpawnBarrierPlane( model, origin, zFloor, slabAng, stepX, stepY, span )
	n += FS_1v1_SpawnBarrierPlane( model, origin, zCeil, slabAng, stepX, stepY, span )

	if ( span >= 400.0 )
		Gamemode1v1_SetWaitingRoomRadius( halfInner - 16.0 )
	printt( "[FS-1V1] arena barrier room origin=" + string( origin ) + " panels=" + string( n ) + " model=" + string( model ) + " inner=" + string( span ) )
}

int function FS_1v1_SpawnBarrierPlane( asset model, vector origin, float z, vector angles, float stepX, float stepY, float cover )
{
	int nX = int( ceil( cover / stepX ) )
	int nY = int( ceil( cover / stepY ) )
	if ( nX < 1 )
		nX = 1
	if ( nY < 1 )
		nY = 1

	float spanX = nX.tofloat() * stepX
	float spanY = nY.tofloat() * stepY
	int n = 0
	int ix
	int iy
	for ( ix = 0; ix < nX; ix++ )
	{
		for ( iy = 0; iy < nY; iy++ )
		{
			float x = origin.x - spanX * 0.5 + stepX * 0.5 + ix.tofloat() * stepX
			float y = origin.y - spanY * 0.5 + stepY * 0.5 + iy.tofloat() * stepY
			if ( FS_1v1_SpawnBarrierPanel( model, <x, y, z>, angles ) )
				n++
		}
	}
	return n
}

asset function FS_1v1_GetArenaBarrierModel()
{
	asset best = $"*1"
	float bestThick = 99999.0
	array<asset> candidates = [ $"*1", $"*2", $"*3", $"*4", $"*5", $"*6", $"*7", $"*8" ]
	foreach ( asset model in candidates )
	{
		entity probe = FS_1v1_CreateBarrierBrush( model, <0, 0, -16000>, <0, 0, 0> )
		if ( !IsValid( probe ) )
			continue

		vector mins = probe.GetBoundingMins()
		vector maxs = probe.GetBoundingMaxs()
		probe.Destroy()

		float sx = maxs.x - mins.x
		float sy = maxs.y - mins.y
		float sz = maxs.z - mins.z
		if ( sx < 4.0 || sy < 4.0 || sz < 200.0 || sx > 4096.0 || sy > 4096.0 )
			continue

		float thick = ( sx <= sy ) ? sx : sy
		float length = ( sx <= sy ) ? sy : sx
		if ( thick > 32.0 || length < 400.0 )
			continue
		if ( thick >= bestThick )
			continue

		bestThick = thick
		best = model
	}

	return best
}

bool function FS_1v1_SpawnBarrierPanel( asset model, vector origin, vector angles )
{
	return IsValid( FS_1v1_CreateBarrierBrush( model, origin, angles ) )
}

entity function FS_1v1_CreateBarrierBrush( asset model, vector origin, vector angles )
{
	entity wall = CreateEntity( "func_brush" )
	if ( !IsValid( wall ) )
		return null

	wall.kv.solid = 6
	wall.kv.solidity = 2
	wall.kv.solidbsp = 0
	wall.kv.triangle_collision = 1
	wall.kv.disableshadows = 1
	wall.kv.angles = angles
	wall.kv.contents = CONTENTS_SOLID | CONTENTS_PLAYERCLIP | CONTENTS_MONSTERCLIP | CONTENTS_NOGRAPPLE | CONTENTS_NOCLIMB | CONTENTS_BULLETCLIP
	wall.SetScriptName( FS_1V1_LOBBY_WALL_SCRIPTNAME )
	wall.SetValueForModelKey( model )
	wall.SetOrigin( origin )
	wall.SetAngles( angles )
	DispatchSpawn( wall )
	if ( !IsValid( wall ) )
		return null
	wall.SetOrigin( origin )
	wall.SetAbsAngles( angles )
	wall.Solid()
	return wall
}
#endif // SERVER

void function Common_DissolveDropable( entity prop )
{
#if SERVER
	if ( !IsValid( prop ) )
		return

	if ( prop.GetScriptName() == "flowstate_halo_mod_weapon" || prop.GetScriptName() == "fs_ball" )
		return

	thread
	(
		void function() : ( prop )
		{
			if ( !IsValid( prop ) )
				return

			prop.EndSignal( "OnDestroy" )
			if ( IsValidSignal( "OnPickup" ) )
				prop.EndSignal( "OnPickup" )

			wait Flowstate_GetDissolveTime()

			if ( IsValid( prop ) )
				prop.Dissolve( ENTITY_DISSOLVE_CORE, <0, 0, 0>, 200 )
		}
	)()
#endif
}

