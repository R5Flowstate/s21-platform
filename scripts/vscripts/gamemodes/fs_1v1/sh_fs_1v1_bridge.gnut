struct
{
	int tdmState = eTDMState.NEXT_ROUND_NOW
	array<void functionref()> tdmStateInProgressCallbacks
	array<string> mAdmins
	string authkey = ""
	bool loggedMsg = false
	bool loggedOITC = false
	bool loggedCustomModel = false
	bool loggedCoachingStub = false
	// true so coaching wait-for-admin never hangs if that path is hit
	bool startNewGame = true
	bool scoreboardShowing = false
	bool bIsChampionShowing = false
} file

// Lead-in before a round's combat clock starts. Drives the TDM countdown RUI and
// holds matchmaking; 0 disables the intro.
float function FS_1v1_RoundIntroTime()
{
	float introTime = GetCurrentPlaylistVarFloat( "fs_1v1_round_intro_time", 3.0 )
	return introTime > 0.0 ? introTime : 0.0
}

int function GetTDMState()
{
	return file.tdmState
}

void function SetTdmStateToNextRound()
{
	// SetGlobalNet* is SERVER-only; client reads via GetGlobalNet*
	#if SERVER
		SetGlobalNetTime( "flowstate_DMRoundEndTime", -1 )
		SetGlobalNetTime( "FSDM_RoundIntroEndTime", -1 )
		// Client clears gamestate matchEndTime from this netvar (RUI_BADGAMETIME is client-only).
		SetGlobalNetInt( "FSDM_GameState", eTDMState.NEXT_ROUND_NOW )
	#endif
	file.tdmState = eTDMState.NEXT_ROUND_NOW
}

void function SetTdmStateToInProgress()
{
	// StartGame also calls this as a netvar safety after the round loop already
	// entered IN_PROGRESS. Re-firing callbacks would double countdown / reset clocks.
	bool alreadyInProgress = ( file.tdmState == eTDMState.IN_PROGRESS )
	file.tdmState = eTDMState.IN_PROGRESS
	#if SERVER
		// Client HUD (rest/wait hints, VS strip) gates on this netvar; file.tdmState alone is not enough.
		SetGlobalNetInt( "FSDM_GameState", eTDMState.IN_PROGRESS )
	#endif
	if ( alreadyInProgress )
		return
	foreach ( cb in file.tdmStateInProgressCallbacks )
		cb()
}

void function AddCallback_OnTdmStateEnter_InProgress( void functionref() callbackFunc )
{
	if ( !file.tdmStateInProgressCallbacks.contains( callbackFunc ) )
		file.tdmStateInProgressCallbacks.append( callbackFunc )
}

float function getkd( int kills, int deaths )
{
	if ( deaths == 0 )
		return kills.tofloat()
	float kd = kills.tofloat() / deaths.tofloat()
	kd = kd * 100.0
	int floorkd = int( floor( kd + 0.5 ) )
	return ( float( floorkd ) ) / 100.0
}

void function __InitAdmins()
{
	file.mAdmins.clear()
	array<string> splitAdmins = split( flowstateSettings.Admins, " " )
	foreach ( string data in splitAdmins )
	{
		string username = strip( data )
		if ( username != "" && file.mAdmins.find( username ) < 0 )
			file.mAdmins.append( username )
	}
}

bool function IsAdmin( entity player )
{
	if ( !IsValid( player ) )
		return false
	// player.p.isAdmin is ServerPlayerStruct-only
	#if SERVER
		if ( player.p.isAdmin )
			return true
	#endif
	return file.mAdmins.find( player.GetPlayerName() ) >= 0
}

void function ClientCommand_adminlogin( entity player, array<string> args )
{
	if ( !IsValid( player ) )
		return
	// Open self-elevation removed. Admins come from flowstateSettings.Admins (IsAdmin name list).
	// Sticky isAdmin only if name is already allowlisted, or authkey is set and args[0] matches.
	#if SERVER
		bool allowlisted = file.mAdmins.find( player.GetPlayerName() ) >= 0
		bool authOk = file.authkey != "" && args.len() > 0 && args[0] == file.authkey
		if ( !allowlisted && !authOk )
		{
			printt( "[FS-1V1] adminlogin DENIED " + player )
			return
		}
		player.p.isAdmin = true
	#endif
	printt( "[FS-1V1] adminlogin OK " + player )
}

void function ClientCommand_God( entity player, array<string> args )
{
	if ( !IsValid( player ) || !IsAdmin( player ) )
		return;	#if SERVER
		player.MakeInvisible() // loud no-op-ish; real god mode later
	#endif
	printt( "[FS-1V1] god stub " + player )
	return;}

void function ClientCommand_UnGod( entity player, array<string> args )
{
	if ( !IsValid( player ) )
		return;	printt( "[FS-1V1] ungod stub " + player )
	return;}

