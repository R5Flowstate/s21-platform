[
	"character_bangalore",
	"character_bloodhound",
	"character_caustic",
	"character_gibraltar",
	"character_lifeline",
	"character_mirage",
	"character_octane",
	"character_pathfinder",
	"character_wraith",
	"character_wattson",
	"character_crypto"
]

