struct
{
	bool helpersInited = false
	bool afkToRest = true
} file

bool function FS_Is1v1Playlist()
{
	string pl = GetCurrentPlaylistName()
	return pl == "fs_1v1" || pl == "fs_vamp_1v1" || pl == "fs_lgduels_1v1" || pl == "fs_1v1_headshots_only" || pl == "fs_1v1_coaching"
}

bool function FS_Is1v1GameMode()
{
	return GameMode_FindByDevName( "fs_1v1" ) != eGameModes.invalid && GameMode_IsActive( GameMode_FindByDevName( "fs_1v1" ) )
}

bool function Flowstate_IsGame1v1Type()
{
	return FS_Is1v1Playlist() || FS_Is1v1GameMode()
}

bool function FS_1v1_IsLobbyState( int state )
{
	return state != e1v1State.SEQUENCE && state != e1v1State.IN_MATCH
}

bool function FS_1v1_ShouldBlockLobbyMelee( entity player )
{
	if ( !Flowstate_IsGame1v1Type() )
		return false
#if UI
	return false
#else
	if ( !IsValid( player ) || !player.IsPlayer() )
		return false
	return player.GetPlayerNetInt( "FS_1v1_PlayerState" ) != e1v1State.IN_MATCH
#endif
}

bool function FS_1v1_ShouldShowCombatHud( int state )
{
	return state == e1v1State.IN_MATCH
}

bool function FS_1v1_PlayerHasClient( entity player )
{
	#if UI
		return false
	#else
		return IsValid( player ) && player.IsPlayer() && !player.IsBot()
	#endif
}

bool function Flowstate_IsLGDuels()
{
	return GetCurrentPlaylistName() == "fs_lgduels_1v1"
}

void function FS_1v1_InitHelpers()
{
	if ( file.helpersInited )
		return

	file.helpersInited = true
	FS_1v1_InitPlaylistSettings()

	#if SERVER || CLIENT
		Remote_RegisterClientFunction( "ServerCallback_1v1_Obituary",
			"int", INT_MIN, INT_MAX, "int", INT_MIN, INT_MAX, "int", INT_MIN, INT_MAX, "int", INT_MIN, INT_MAX,
			"int", INT_MIN, INT_MAX, "int", INT_MIN, INT_MAX, "int", INT_MIN, INT_MAX, "int", INT_MIN, INT_MAX,
			"int", INT_MIN, INT_MAX, "int", 0, 255 )
	#endif

	#if SERVER
		AddCallback_OnPlayerKilled( Gamemode1v1_BroadcastObituary )
	#endif

	printt( "[FS-1V1] helpers ready playlist='" + GetCurrentPlaylistName() + "' is1v1=" + string( FS_Is1v1Playlist() ) + " force=" + string( FS_1v1_IsForceCharacter() ) + " chosen=" + string( FlowState_ChosenCharacter() ) )
}

void function FS_1v1_InitPlaylistSettings()
{
	flowstateSettings.ForceCharacter = GetCurrentPlaylistVarBool( "flowstateForceCharacter", GetCurrentPlaylistName() == "fs_1v1" )
	flowstateSettings.is_halo_gamemode = GetCurrentPlaylistVarBool( "is_halo_gamemode", false )
	flowstateSettings.RandomCharacterOnSpawn = GetCurrentPlaylistVarBool( "flowstateRandomCharacterOnSpawn", false )
	flowstateSettings.GiveAllOpticsToPlayer = GetCurrentPlaylistVarBool( "flowstateGiveAllOpticsToPlayer", false )
	flowstateSettings.hackersVsPros = GetCurrentPlaylistVarBool( "flowstate_hackersVsPros", false )
	flowstateSettings.enable_afk_thread = GetCurrentPlaylistVarBool( "enable_afk_thread", true )
	flowstateSettings.enable_ping_kick = GetCurrentPlaylistVarBool( "enable_ping_kick", false )
	file.afkToRest = GetCurrentPlaylistVarBool( "afk_to_rest_bool", true )
	flowstateSettings.aimassist_magnet_pc = GetCurrentPlaylistVarFloat( "aimassist_magnet_pc", 0.0 )
	flowstateSettings.BattleLogEnable = GetCurrentPlaylistVarBool( "flowstateBattleLogEnable", false )
	flowstateSettings.BattleLog_Linux = GetCurrentPlaylistVarBool( "flowstateBattleLog_Linux", false )
	flowstateSettings.custom_match_ending_title = GetCurrentPlaylistVarString( "custom_match_ending_title", "Server clean up incoming" )
	flowstateSettings.custom_match_ending_message = GetCurrentPlaylistVarString( "custom_match_ending_message", "Don't leave. Server is going to reload to avoid lag." )
	flowstateSettings.end_match_message = GetCurrentPlaylistVarBool( "end_match_message", true )
	flowstateSettings.rotate_map = GetCurrentPlaylistVarBool( "rotate_map", false )
	flowstateSettings.maplist = GetCurrentPlaylistVarString( "maplist", "" )
	flowstateSettings.ring_radius_padding = GetCurrentPlaylistVarFloat( "ring_radius_padding", 800 )
	flowstateSettings.Admins = GetCurrentPlaylistVarString( "Admins", "" )
	flowstateSettings.enable_oddball_gamemode = GetCurrentPlaylistVarBool( "enable_oddball_gamemode", false )
	flowstateSettings.default_ibmm_wait = GetCurrentPlaylistVarFloat( "default_ibmm_wait", 0 )
	flowstateSettings.ReloadTacticalOnRespawn = GetCurrentPlaylistVarBool( "flowstateReloadTacticalOnRespawn", false )
	flowstateSettings.ReloadUltimateOnRespawn = GetCurrentPlaylistVarBool( "flowstateReloadUltimateOnRespawn", false )
	flowstateSettings.RandomHaloGuns = GetCurrentPlaylistVarBool( "flowstateRandomHaloGuns", false )
	flowstateSettings.DroppodsOnPlayerConnected = GetCurrentPlaylistVarBool( "flowstateDroppodsOnPlayerConnected", false )
	flowstateSettings.EndlessFFAorTDM = GetCurrentPlaylistVarBool( "flowstateEndlessFFAorTDM", false )
	flowstateSettings.endgame_delay = GetCurrentPlaylistVarInt( "endgame_delay", 6 )
	flowstateSettings.enable_global_chat = GetCurrentPlaylistVarBool( "enable_global_chat", true )
	flowstateSettings.allow_cfgs = GetCurrentPlaylistVarBool( "flowstate_allow_cfgs", false )
	flowstateSettings.give_random_custom_models_toall = GetCurrentPlaylistVarBool( "flowstate_give_random_custom_models_toall", false )
	flowstateSettings.show_short_champion_screen = GetCurrentPlaylistVarBool( "show_short_champion_screen", true )
	flowstateSettings.bIsRealisticMode = GetCurrentPlaylistName() == "fs_realistic_ttv"
	flowstateSettings.give_weapon_stack_count_amount = GetCurrentPlaylistVarInt( "give_weapon_stack_count_amount", 0 )
}

int function FlowState_ChosenCharacter()
{
	return GetCurrentPlaylistVarInt( "flowstateChosenCharacter", FS_1V1_DEFAULT_LEGEND_INDEX )
}

ItemFlavor function FS_1v1_GetCharacterFlavorByIndex( int index )
{
	if ( index < 0 || index >= LEGEND_CHARACTER_REFS.len() )
		index = FS_1V1_DEFAULT_LEGEND_INDEX

	string ref = LEGEND_CHARACTER_REFS[ index ]
	if ( IsValidItemFlavorCharacterRef( ref ) )
		return GetItemFlavorByCharacterRef( ref )

	printt( format( "[FS-1V1][LEGEND] ref '%s' (index %d) is not a valid character ref", ref, index ) )

	if ( IsValidItemFlavorCharacterRef( FS_1V1_DEFAULT_LEGEND_REF ) )
		return GetItemFlavorByCharacterRef( FS_1V1_DEFAULT_LEGEND_REF )

	if ( IsValidItemFlavorSettingsAsset( $"settings/itemflav/character/wraith.rpak" ) )
		return GetItemFlavorByAsset( $"settings/itemflav/character/wraith.rpak" )

	printt( "[FS-1V1][LEGEND] no character refs resolve at all -- registry is not populated" )
	return Loadout_Character().defaultItemFlavor
}

// flowstateChosenCharacterRef names a legend the index table does not carry.
ItemFlavor function FS_1v1_GetForcedCharacterFlavor()
{
	string ref = strip( GetCurrentPlaylistVarString( "flowstateChosenCharacterRef", "" ) )
	if ( ref != "" )
	{
		if ( IsValidItemFlavorCharacterRef( ref ) )
			return GetItemFlavorByCharacterRef( ref )
		printt( "[FS-1V1][LEGEND] flowstateChosenCharacterRef '" + ref + "' is not a registered character ref -- using flowstateChosenCharacter" )
	}
	return FS_1v1_GetCharacterFlavorByIndex( FlowState_ChosenCharacter() )
}

// SharedInit runs before ShPlaylist_Init; the client never re-reads the cache.
// Missing var on fs_1v1 still forces -- that playlist's contract is one legend.
bool function FS_1v1_IsForceCharacter()
{
	bool force = GetCurrentPlaylistVarBool( "flowstateForceCharacter", GetCurrentPlaylistName() == "fs_1v1" )
	flowstateSettings.ForceCharacter = force
	return force
}

