// From sh_gamemode_scenarios (scenarios not ported; const still needed by 1v1 init).
global const int SCENARIOS_MAX_ALLOWED_TEAMSIZE = 5
// Indices into LEGEND_CHARACTER_REFS. Anything above the last entry is a custom
// pilot model, not a legend, and resolves through SetPlayerCustomModel instead.
global const int FS_1V1_DEFAULT_LEGEND_INDEX = 8 // Wraith
global const string FS_1V1_DEFAULT_LEGEND_REF = "character_wraith"
global const int FS_1V1_LAST_LEGEND_INDEX = 10
global const int FS_1V1_CAMO_RANDOM = 9

// GetAllCharacters() is registration order, not this list. Resolve by ref.
