}

bool function Tracker_IsSafeMapName( string mapName )
{
	int n = mapName.len()
	if ( n < 3 || n > 63 )
		return false

	for ( int i = 0; i < n; i++ )
	{
		string ch = mapName.slice( i, i + 1 )
		if ( ch == "_" )
			continue
		if ( ch >= "a" && ch <= "z" )
			continue
		if ( ch >= "0" && ch <= "9" )
			continue
		return false
	}

	return true
}

array<string> function Tracker_ParseMapList( string raw )
{
	array<string> maps
	array<string> parts = split( raw, "," )
	foreach ( string p in parts )
	{
		string mapName = strip( p )
		if ( mapName == "" )
			continue
		maps.append( mapName )
	}
	return maps
}

array<string> function Tracker_GetRotateMaps()
{
	array<string> raw
	string overrideList = GetCurrentPlaylistVarString( "maplist", "" )
	if ( overrideList == "" )
		overrideList = flowstateSettings.maplist

	if ( overrideList != "" )
		raw = Tracker_ParseMapList( overrideList )
	else
		raw = GetPlaylistMaps( GetCurrentPlaylistName() )

	array<string> installed
	bool haveInstalled = false
	#if SERVER
	try
	{
		installed = GetAvailableMaps()
		haveInstalled = installed.len() > 0
	}
	catch ( e )
	{
		haveInstalled = false
	}
	#endif

	array<string> maps
	foreach ( string mapName in raw )
	{
		if ( mapName == "" )
			continue
		if ( !Tracker_IsSafeMapName( mapName ) )
		{
			printt( "[FS-1V1] skip unsafe map '" + mapName + "'" )
			continue
		}
		if ( !GetCurrentPlaylistVarBool( "fs_1v1_rotate_" + mapName, true ) )
		{
			printt( "[FS-1V1] skip rotate-disabled map '" + mapName + "'" )
			continue
		}
		if ( haveInstalled && !installed.contains( mapName ) )
		{
			printt( "[FS-1V1] skip uninstalled map '" + mapName + "'" )
			continue
		}
		if ( maps.contains( mapName ) )
			continue
		maps.append( mapName )
	}

	return maps
}

string function Tracker_DetermineNextMap()
{
	#if UI
		return ""
	#else
		array<string> maps = Tracker_GetRotateMaps()
		string cur = GetMapName()
		if ( maps.len() == 0 )
		{
			printt( "[FS-1V1] DetermineNextMap empty pool, staying on " + cur )
			return cur
		}

		int idx = maps.find( cur )
		int next = 0
		if ( idx >= 0 )
			next = ( idx + 1 ) % maps.len()

		string to_map = maps[next]
		printt( "[FS-1V1] DetermineNextMap cur=" + cur + " next=" + to_map + " idx=" + string( idx ) + " pool=" + string( maps.len() ) )
		return to_map
	#endif
}

void function Tracker_GotoNextMap()
{
	#if SERVER
		string to_map = Tracker_DetermineNextMap()
		string playlist = GetCurrentPlaylistName()
		if ( to_map == "" || !Tracker_IsSafeMapName( to_map ) )
		{
			printt( "[FS-1V1] GotoNextMap aborted: bad map '" + to_map + "' playlist=" + playlist )
			return
		}
		printt( "[FS-1V1] GotoNextMap map=" + to_map + " playlist=" + playlist )
		GameRules_ChangeMap( to_map, playlist )
	#else
		printt( "[FS-1V1] GotoNextMap ignored (not server)" )
	#endif
}

void function FlowstateTracker_Finalize( string platformUid, bool unused )
{
}

// No damage-event tracker ported -- rest grace treats last hit as ancient.
DamageEvent function Tracker_GetCurrentEventForAttackerOnVictim( int attackerHandle, int victimHandle )
{
	DamageEvent e
	e.attackerHandle = attackerHandle
	e.victimHandle = victimHandle
	e.lastHitTimestamp = 0.0
	e.isValid = false
	return e
}

void function Tracker_SetPlayerAsChampion( entity player )
{
	// UI VM has no entity methods at compile time (GetPlayerName etc.).
	#if UI
		printt( "[FS-Tracker] SetPlayerAsChampion stub" )
	#else
		if ( IsValid( player ) )
			printt( "[FS-Tracker] SetPlayerAsChampion stub " + player.GetPlayerName() )
	#endif
}
