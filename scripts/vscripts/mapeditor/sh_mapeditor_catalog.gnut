void function _AddCategory( string category, string tier, array< asset > models, array< int > ids, array< int > masks )
{
	if ( !( category in file.byCategory ) )
	{
		file.byCategory[ category ] <- []
		file.categoryTier[ category ] <- tier
		file.categories.append( category )
	}

	foreach ( int idx, asset model in models )
	{
		MapEditorCatalogEntry entry
		entry.id       = ids[ idx ]
		entry.category = category
		entry.tier     = tier
		entry.mapMask  = masks[ idx ]
		entry.model    = model

		file.byId[ entry.id ] <- entry
		file.byModel[ model ] <- entry
		file.byCategory[ category ].append( entry )
	}
}

MapEditorCatalogEntry ornull function MapEditorCatalog_GetEntry( int id )
{
	if ( id in file.byId )
		return file.byId[ id ]
	return null
}

array< string > function MapEditorCatalog_GetCategories()
{
	return file.categories
}

array< string > function MapEditorCatalog_GetCategoriesByTier( string tier )
{
	array< string > result
	foreach ( string category in file.categories )
	{
		if ( category in file.categoryTier && file.categoryTier[ category ] == tier )
			result.append( category )
	}
	return result
}

array< MapEditorCatalogEntry > function MapEditorCatalog_GetCategoryEntries( string category )
{
	if ( category in file.byCategory )
		return file.byCategory[ category ]
	return []
}

int function MapEditorCatalog_Count()
{
	return file.byId.len()
}

int function MapEditorCatalog_GetMapBit( string mapName )
{
	if ( mapName in file.mapBits )
		return file.mapBits[ mapName ]
	return -1
}

string function MapEditorCatalog_GetMapNameForBit( int bit )
{
	foreach ( string mapName, int mapBit in file.mapBits )
	{
		if ( mapBit == bit )
			return mapName
	}
	return ""
}

void function MapEditorCatalog_SetActivePackMask( int mask )
{
	file.activePackMask = mask
}

int function MapEditorCatalog_GetActivePackMask()
{
	return file.activePackMask
}

bool function MapEditorCatalog_IsAvailableOnMap( MapEditorCatalogEntry entry, string mapName )
{
	int bit = MapEditorCatalog_GetMapBit( mapName )
	if ( bit < 0 )
		return ( entry.mapMask & 1 ) != 0
	if ( ( entry.mapMask & 1 ) != 0 )
		return true
	return ( entry.mapMask & ( ( 1 << bit ) | file.activePackMask ) ) != 0
}

bool function MapEditorCatalog_IsModelAvailableOnMap( asset model, string mapName )
{
	if ( !( model in file.byModel ) )
		return true
	return MapEditorCatalog_IsAvailableOnMap( file.byModel[ model ], mapName )
}

array< MapEditorCatalogEntry > function MapEditorCatalog_GetAvailableCategoryEntries( string category, string mapName )
{
	array< MapEditorCatalogEntry > result
	if ( !( category in file.byCategory ) )
		return result
	foreach ( MapEditorCatalogEntry entry in file.byCategory[ category ] )
	{
		if ( MapEditorCatalog_IsAvailableOnMap( entry, mapName ) )
			result.append( entry )
	}
	return result
}

MapEditorCatalogEntry ornull function MapEditorCatalog_GetFirstAvailable( string mapName, string tier )
{
	foreach ( string category in file.categories )
	{
		if ( !( category in file.categoryTier ) || file.categoryTier[ category ] != tier )
			continue
		foreach ( MapEditorCatalogEntry entry in file.byCategory[ category ] )
		{
			if ( MapEditorCatalog_IsAvailableOnMap( entry, mapName ) )
				return entry
		}
	}
	return null
}
