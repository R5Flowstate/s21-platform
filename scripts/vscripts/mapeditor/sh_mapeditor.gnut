// Map editor shared gate and constants.
// Mode reuses SURVIVAL inits and self-gates on the playlist var.

global function MapEditor_IsEnabled
global function MapEditor_SharedInit

global const int   MAPEDIT_PROP_CAP_GLOBAL   = 1500
global const int   MAPEDIT_PROP_CAP_PLAYER   = 300
global const float MAPEDIT_MAX_PLACE_DIST    = 4096.0
global const float MAPEDIT_WORLD_LIMIT       = 65536.0
global const float MAPEDIT_ANGLE_LIMIT       = 1000000.0
global const int   MAPEDIT_PLACE_RATE_MAX    = 10
global const float MAPEDIT_PLACE_RATE_WINDOW = 1.0
global const int   MAPEDIT_UNDO_DEPTH        = 64
// Holding the editor tool is build mode. Slot 3 is the utility slot on both engines;
// the sling slot 4 is the anti-titan slot on the S3 server.
global const string MAPEDIT_TOOL_WEAPON      = "mp_weapon_mapedit_tool"
// WEAPON_INVENTORY_SLOT_PRIMARY_3; the UI VM has no weapon slot constants.
global const int   MAPEDIT_TOOL_SLOT         = 3

// Models precached for the editor, on top of everything the map already
// precaches. Kept small on purpose: model indices past 8192 leave the client's
// inline precache array and land in a shadow buffer, and a big map plus a big
// editor list is enough to cross that line and take the client down during
// signon. Raising this needs the resulting index range measured first.
global const int   MAPEDIT_PRECACHE_MAX      = 256

// Everything else is precached one model at a time, when it is first picked
// (client) or first placed (server). Late precache is the proven path; this caps
// how far one level can push the model table that way.
global const int   MAPEDIT_LAZY_PRECACHE_MAX = 1536
global const int   MAPEDIT_LAZY_PRECACHE_PER_PLAYER = 256
global const int   MAPEDIT_MODEL_REQUESTS_PER_SEC = 12
global const float MAPEDIT_MODEL_REQUEST_RETRY = 2.0

global enum ePackRefusal
{
	FAILED,
	ADMIN_ONLY,
	REJECTED,
}

// Extended palette / zipline
global const float MAPEDIT_ZIPLINE_MAX_DIST  = 8192.0
global const float MAPEDIT_JUMP_PAD_RADIUS   = 32.0
global const float MAPEDIT_JUMP_PAD_HEIGHT   = 32.0
global const float MAPEDIT_JUMP_PAD_BELOW    = 16.0
global const float MAPEDIT_JUMP_PAD_VELOCITY = 1150.0
global const float MAPEDIT_JUMP_PAD_VERT     = 2.0
global const float MAPEDIT_DOOR_DOUBLE_GAP   = 64.0
// Palette recipe models: the server spawns them, the client previews them.
global const asset MAPEDIT_JUMP_PAD_MODEL = $"mdl/props/octane_jump_pad/octane_jump_pad.rmdl"
global const asset MAPEDIT_DOOR_MODEL = $"mdl/door/door_104x64x8_elevatorstyle01_right_animated.rmdl"
global const asset MAPEDIT_LOOT_BIN_MODEL = $"mdl/props/loot_bin/loot_bin_01_loba.rmdl"

// Client tool
global const float MAPEDIT_TRACE_DIST        = 4000.0
global const float MAPEDIT_Z_STEP            = 16.0
global const float MAPEDIT_Z_LIMIT           = 2048.0
global const int   MAPEDIT_ANGLE_STEP        = 15

// Seconds for the drawn preview to catch up to where the trace says it goes.
global const float MAPEDIT_GHOST_SMOOTH_TIME = 0.05
// Past this jump the preview cuts instead of sliding, so looking from a near
// wall to the skybox does not drag the model across the level.
global const float MAPEDIT_GHOST_CUT_DIST    = 600.0

// Saved layouts: one auto slot per map plus numbered slots.
global const int   MAPEDIT_SAVE_SLOTS        = 5
global const float MAPEDIT_AUTOSAVE_DELAY    = 3.0
global const float MAPEDIT_SAVE_CMD_COOLDOWN = 2.0
global const int   MAPEDIT_RESTORE_PER_FRAME = 16

global enum eMapEditKind
{
	PROP,
	SPECIAL,
	ZIPLINE,
}

#if SERVER
// One user action; every entity it spawned shares the placement's group.
global struct MapEditPlacement
{
	int    kind
	int    id
	vector origin
	vector angles
	vector endOrigin
}
#endif

bool function MapEditor_IsEnabled()
{
#if SERVER || CLIENT
	return GetCurrentPlaylistVarBool( "mapeditor_enabled", false )
#else
	return false
#endif
}

void function MapEditor_SharedInit()
{
	if ( !MapEditor_IsEnabled() )
		return

	printt( "[MAPEDIT] shared init" )
}
