global const asset FIRINGRANGE_ITEM_RESPAWN_PARTICLE = $"P_impact_shieldbreaker_sparks"
global const int PLAYER_MELEE_STATE_KICK_ATTACK = 1
global const int PLAYER_MELEE_STATE_SLAM_ATTACK = 2
// UI already has a real definition for these; only SERVER/CLIENT need them.
// Trigger types are bit flags and travel to the client, so these must be the
// client's values -- as zeroes they silently dropped out of every
// SetIgnorePredictedTriggerTypes mask they appeared in.
#if SERVER
global const int TT_GRAVITY_LIFT = 4
global const int TT_BLACKHOLE = 8
global const int TT_GRAVITY_CANNON = 32
#endif
// The melee states this engine registers are HUMAN_-prefixed, so these names do
// not collide and nothing corrects a wrong value. Must match what the client
// predicts: 3 is EXECUTION_PREDICTED, 4 is EXECUTION.
global const int PLAYER_MELEE_STATE_EXECUTION = 4
global const int CODE_REDEMPTION_RESULT_SUCCESS = 0
global const int playedApexFalse = 0

