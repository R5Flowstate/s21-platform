void function OnWeaponReload_weapon_autopistol_fusion( entity weapon, int milestoneIndex )
{
#if CLIENT
	// Reloading drops the charge, otherwise the gun keeps a full meter across
	// the reload and the next trigger pull skips the wind-up.
	if ( !(InPrediction() && IsFirstTimePredicted()) )
		return

	weapon.SetWeaponChargeFractionForced( 0.0 )
#endif
}

