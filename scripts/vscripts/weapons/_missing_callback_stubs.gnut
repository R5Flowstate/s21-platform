struct
{
	table<string, bool> announced
} file

void function MissingCallbackStub_Note( string name )
{
	if ( name in file.announced )
		return

	file.announced[name] <- true
	printt( "[WEAPON-STUB] " + name + " is not implemented in this build" )
}

var function Ball_OnWeaponTossReleaseAnimEvent( entity weapon, WeaponPrimaryAttackParams params )
{
	MissingCallbackStub_Note( "Ball_OnWeaponTossReleaseAnimEvent" )
	return 0
}

