global const bool REMAP_LOAD_MAP = false

global function Sh_ReMap_Init
global function Sh_ReMap_Clear
global function Sh_ReMap_PrecacheMap

void function Sh_ReMap_Init()
{
#if SERVER
	ReMap_PrecacheZiplines()
	ReMap_RegisterTextInfoPanelCallbacks()
	if ( reloadingScripts )
		ReMap_ConfigureEntProps()
	else
		AddCallback_EntitiesDidLoad( ReMap_ConfigureEntProps )
#endif
	Sh_ReMap_PrecacheMap()

#if REMAP_LOAD_MAP
#if SERVER
	AddCallback_EntitiesDidLoad( Sv_ReMap_LoadMap )
#endif // SERVER
#if CLIENT
	AddCallback_EntitiesDidLoad( Cl_ReMap_LoadMap )
#endif // CLIENT
#endif // REMAP_LOAD_MAP
}

void function Sh_ReMap_PrecacheMap()
{
	PrecacheModel( $"mdl/dev/empty_model.rmdl" )
}

void function Sh_ReMap_Clear()
{
#if SERVER
	ReMap_ClearProps()
	ReMap_ClearZiplines()
#elseif CLIENT
	ReMap_ClearClientProps()
#endif
}
